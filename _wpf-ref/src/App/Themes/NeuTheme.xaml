<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         深色新拟物（Dark Neumorphism）统一主题
         本文件是全部新拟物资源的唯一出处：调色板 / 表面 / 描边 / 阴影 /
         按钮 / 页签 / 面板 / 输入框 / 滚动条 / 提示等。
         改主题只改这里，各窗口/面板一律引用，禁止在使用处散落硬编码。
         原理：控件与背景同色，靠「左上浅 / 右下深」的斜向描边 +
         右下 DropShadow 深影形成外凸(raised)；点击时反转为内凹(inset)。
         ============================================================ -->

    <!-- 基础调色板 -->
    <SolidColorBrush x:Key="BgBrush"    Color="#FF1F2126"/>   <!-- 窗口底 -->
    <SolidColorBrush x:Key="BarBrush"   Color="#FF262931"/>   <!-- 栏/标题带 -->
    <SolidColorBrush x:Key="CardBrush"  Color="#FF2A2E37"/>   <!-- 卡片凸起面 -->
    <SolidColorBrush x:Key="MainBrush"  Color="#FFECEDF0"/>   <!-- 主文字 -->
    <SolidColorBrush x:Key="MutedBrush" Color="#FF9AA0AA"/>   <!-- 次要文字 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF5D9BFF"/>  <!-- 强调蓝 -->
    <SolidColorBrush x:Key="LockBrush" Color="#FFA98A52"/>  <!-- 锁定指示：低饱和暗金（锁图标等状态标记） -->
    <SolidColorBrush x:Key="BorderBrush" Color="#FF38404B"/>  <!-- 常规细边 -->
    <SolidColorBrush x:Key="LineHoverBrush" Color="#FF5C7093"/>  <!-- 钢蓝灰：滚动条/分隔条/拖动插入条悬停线（偏蓝调、比亮灰更暗，显眼不刺眼） -->
    <SolidColorBrush x:Key="LineActiveBrush" Color="#FF7085A8"/>  <!-- 钢蓝灰偏亮：滚动条/分隔条/拖动插入条拖动线 -->

    <!-- 面板/浏览区专用（TipsPanel / AgentSkillPanel / SettingsPanel 引用；换肤统一改这里） -->
    <SolidColorBrush x:Key="GuideBorderBrush"  Color="#FF3A4250"/> <!-- 使用说明浮层边框 -->
    <SolidColorBrush x:Key="GuideBgBrush"      Color="#FF161B22"/> <!-- 使用说明浮层底色 -->
    <SolidColorBrush x:Key="GuideTextBrush"    Color="#FFEAECEF"/> <!-- 使用说明正文 -->
    <SolidColorBrush x:Key="GuideLineBrush"    Color="#FF3E4F68"/> <!-- agent/skill 分级色带 -->
    <SolidColorBrush x:Key="FolderBarBrush"    Color="#FFC9A15A"/> <!-- skill 目录条低饱和金 -->
    <SolidColorBrush x:Key="FolderIconBrush"   Color="#FFA9B6D4"/> <!-- 目录图标淡蓝 -->
    <SolidColorBrush x:Key="FolderNameBrush"   Color="#FF9FB3D6"/> <!-- 目录名淡靛 -->
    <SolidColorBrush x:Key="ChipRowBrush"           Color="#FF232A36"/> <!-- 列表行背景常态 -->
    <SolidColorBrush x:Key="ChipRowHoverBrush"      Color="#FF242C39"/> <!-- 行悬停 -->
    <SolidColorBrush x:Key="ChipRowActiveBrush"     Color="#FF262F3D"/> <!-- 行选中 -->
    <SolidColorBrush x:Key="ChipRowActiveHoverBrush" Color="#FF293341"/> <!-- 行选中+悬停 -->
    <SolidColorBrush x:Key="CountTextBrush"    Color="#FFB4B9C2"/> <!-- 标题计数等弱数字 -->
    <SolidColorBrush x:Key="ErrorTextBrush"    Color="#FFE5484D"/> <!-- 错误提示红字 / 危险按钮前景 -->
    <SolidColorBrush x:Key="SelectionFillBrush" Color="#303B82F6"/> <!-- 拖拽目标分组高亮填充（半透明强调蓝） -->

    <!-- 新拟物专用表面 -->
    <SolidColorBrush x:Key="NeuSurface"    Color="#FF2B2F38"/> <!-- 凸起面 -->
    <SolidColorBrush x:Key="NeuSurfaceLo"  Color="#FF242832"/> <!-- 分框承载面（比卡片略深，使卡片凸起更明显） -->
    <SolidColorBrush x:Key="NeuSurfaceHi"  Color="#FF353A45"/> <!-- 悬停更高凸起 -->
    <SolidColorBrush x:Key="NeuInset"      Color="#FF1C1F25"/> <!-- 内凹面 -->
    <SolidColorBrush x:Key="NeuAccentTint" Color="#FF353A45"/> <!-- 选中：新拟物柔和高亮面（中性，不刺眼） -->
    <!-- 新拟物渐变表面（参考开源拟态 145° 渐变软垫手法）：左上受光、右下收暗，模拟软垫隆起。
         对比度刻意克制（深色底过强会变"亮面塑料"），调强度只改这里，全局生效。 -->
    <LinearGradientBrush x:Key="NeuSurfaceGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF333946" Offset="0.0"/>
        <GradientStop Color="#FF2B2F38" Offset="0.45"/>
        <GradientStop Color="#FF272B33" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NeuSurfaceHiGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF3A414E" Offset="0.0"/>
        <GradientStop Color="#FF353A45" Offset="0.45"/>
        <GradientStop Color="#FF2F343E" Offset="1.0"/>
    </LinearGradientBrush>
    <!-- 承载面渐变（比 NeuSurfaceGrad 略深，用于分框/集群卡片，使内部卡片凸起更明显） -->
    <LinearGradientBrush x:Key="NeuSurfaceLoGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF2B303C" Offset="0.0"/>
        <GradientStop Color="#FF242832" Offset="0.45"/>
        <GradientStop Color="#FF21252E" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- 外凸描边：左上浅、右下深（多段柔和过渡，模拟「圆弧平缓爬升」的软垫隆起，降低雕刻感） -->
    <LinearGradientBrush x:Key="NeuBezel" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF383E49" Offset="0.0"/>
        <GradientStop Color="#FF2F343E" Offset="0.35"/>
        <GradientStop Color="#FF282D36" Offset="0.65"/>
        <GradientStop Color="#FF23272E" Offset="1.0"/>
    </LinearGradientBrush>
    <!-- 悬停更高凸起的描边 -->
    <LinearGradientBrush x:Key="NeuBezelHi" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF414854" Offset="0.0"/>
        <GradientStop Color="#FF363C47" Offset="0.35"/>
        <GradientStop Color="#FF2E333D" Offset="0.65"/>
        <GradientStop Color="#FF282D35" Offset="1.0"/>
    </LinearGradientBrush>
    <!-- 选中描边：中性提亮（比悬停更高凸起更亮，作卡片选中指示，不引入彩色） -->
    <LinearGradientBrush x:Key="NeuBezelSel" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF8A93A5" Offset="0.0"/>
        <GradientStop Color="#FF7B8495" Offset="0.35"/>
        <GradientStop Color="#FF6D7687" Offset="0.65"/>
        <GradientStop Color="#FF626B7C" Offset="1.0"/>
    </LinearGradientBrush>
    <!-- 内凹描边：左上深、右下浅（同样柔和过渡） -->
    <LinearGradientBrush x:Key="NeuBezelPress" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF1B1E24" Offset="0.0"/>
        <GradientStop Color="#FF252A32" Offset="0.45"/>
        <GradientStop Color="#FF2E333C" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- 外凸深影（右下）：棉柔蓬松 → 大模糊 + 低透明度 + 浅深度，让控件像软垫般轻贴面板 -->
    <DropShadowEffect x:Key="NeuShadow"      Color="#000000" BlurRadius="22" ShadowDepth="1.5" Direction="315" Opacity="0.28"/>
    <DropShadowEffect x:Key="NeuShadowSmall" Color="#000000" BlurRadius="16" ShadowDepth="1.5" Direction="315" Opacity="0.25"/>
    <!-- 悬停抬升（floating）：比常态稍柔地浮起 -->
    <DropShadowEffect x:Key="NeuShadowFloat" Color="#000000" BlurRadius="30" ShadowDepth="2"   Direction="315" Opacity="0.28"/>
    <!-- 内凹浅内影（按压/承载区） -->
    <DropShadowEffect x:Key="NeuShadowInner" Color="#000000" BlurRadius="12" ShadowDepth="1"   Direction="135" Opacity="0.20"/>
    <!-- 内凹微影（软键 hover / 按下 / 激活态）：TitleBtn / CardTile / 顶栏激活插件 等共用，
         按"悬浮中下凹 → 按下最深"的深度分级。改阴影强度只动这里，各处同步生效。 -->
    <DropShadowEffect x:Key="NeuShadowInsetHover" Color="#000000" BlurRadius="10"  ShadowDepth="0.9" Direction="135" Opacity="0.18"/>
    <DropShadowEffect x:Key="NeuShadowInsetPress" Color="#000000" BlurRadius="13"  ShadowDepth="1.1" Direction="135" Opacity="0.22"/>
    <DropShadowEffect x:Key="NeuShadowActive"      Color="#000000" BlurRadius="8"   ShadowDepth="0.7" Direction="135" Opacity="0.15"/>

    <!-- ============ 统一圆角 Tokens：半径唯一出处，各控件一律引用、禁止散落硬编码 ============
         改圆角只改对应的 NeuRadius*，全局同步；组合角（如 8,8,0,0 / 0,0,7,7 仅部分角圆角）
         语义特殊，保留在位不参与 token。 -->
    <CornerRadius x:Key="NeuRadius1">1</CornerRadius>
    <CornerRadius x:Key="NeuRadius2">2</CornerRadius>
    <CornerRadius x:Key="NeuRadius3">3</CornerRadius>
    <CornerRadius x:Key="NeuRadius4">4</CornerRadius>
    <CornerRadius x:Key="NeuRadius5">5</CornerRadius>
    <CornerRadius x:Key="NeuRadius6">6</CornerRadius>
    <CornerRadius x:Key="NeuRadius7">7</CornerRadius>
    <CornerRadius x:Key="NeuRadius8">8</CornerRadius>
    <CornerRadius x:Key="NeuRadius10">10</CornerRadius>
    <CornerRadius x:Key="NeuRadius14">14</CornerRadius>

    <!-- ============ 标题文字浮雕（深色新拟物：上浅下深的纵向渐变 + 右下微影 = 凸起浮雕感） ============ -->
    <!-- 分栏/面板标题统一银白浮雕；对比度刻意调低（低调化），避免过炫。 -->
    <LinearGradientBrush x:Key="TitleEmbossBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF1F3F8" Offset="0.0"/>  <!-- 上：受光高亮 -->
        <GradientStop Color="#FFC0C8D4" Offset="0.55"/>
        <GradientStop Color="#FFA6AFBF" Offset="1.0"/>  <!-- 下：收暗 -->
    </LinearGradientBrush>
    <!-- 文字凸起微影：右下深影把文字"托起"；柔化阴影降透明，配合低调化浮雕 -->
    <DropShadowEffect x:Key="TextEmboss" Color="#000000" BlurRadius="3" ShadowDepth="1.3" Direction="315" Opacity="0.42"/>

    <!-- ============ 统一标题样式：字号集中在此调整，各处只引用不再散落硬编码 ============ -->
    <!-- 分栏标题（项目组 / 项目 / agents / skills / 链接记录）：纯色统一风 -->
    <Style x:Key="ColumnTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource MainBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- 窗口主标题（分配项目组） -->
    <Style x:Key="AppTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource MainBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ============ 统一排版 Tokens：MCP / 设置 / TIPS 等浮层面板共用 ============
         字号/画刷/权重集中在此，各面板（含内部小面板/卡片）一律引用、不再散落硬编码。
         层级：PanelTitle > SectionTitle > ItemTitle(含等宽 Mono) ；正文/说明/标签分级配套。
         换行等"布局"性差异允许各面板在引用处以局部属性叠加（如 TextWrapping/Margin），不改动字体本身。 -->
    <!-- 浮层主标题（MCP 工具开关 / 设置 / 使用说明） -->
    <Style x:Key="PanelTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TitleEmbossBrush}"/>
        <Setter Property="Effect" Value="{StaticResource TextEmboss}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- 章节标题（面板内分区/分组卡片标题） -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TitleEmbossBrush}"/>
        <Setter Property="Effect" Value="{StaticResource TextEmboss}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- 条目标题（列表/卡片内的条目名） -->
    <Style x:Key="ItemTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource MainBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- 等宽条目标题（agent 名 / 工具名 / 链接名等标识符） -->
    <Style x:Key="ItemTitleMono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource MainBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- 章节/条目说明文字 -->
    <Style x:Key="SectionDesc" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- 输入字段小标签（设置/表单） -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    </Style>
    <!-- 脚注/底部提示 -->
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- 卡片：外凸新拟物（背景同色 + 斜向描边 + 右下深影，圆角加大） -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NeuBezel}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource NeuRadius14}"/>
        <Setter Property="Effect" Value="{StaticResource NeuShadow}"/>
    </Style>

    <!-- 深色框（内凹承载区）：项目组 / 项目 / 日志 共用，分框与按钮坐于其内 -->
    <Style x:Key="DarkFrame" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource NeuInset}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NeuBezelPress}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource NeuRadius8}"/>
        <Setter Property="Effect" Value="{StaticResource NeuShadowInner}"/>
    </Style>

    <!-- 新拟物勾选框：未选=外凸小方块，选中=内凹+蓝勾（设置 / MCP 面板共用） -->
    <Style x:Key="CheckLabel" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource MainBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="box" Width="18" Height="18" CornerRadius="{StaticResource NeuRadius5}"
                                Background="{StaticResource NeuSurface}"
                                BorderBrush="{StaticResource NeuBezel}" BorderThickness="1"
                                Effect="{StaticResource NeuShadowSmall}" VerticalAlignment="Center">
                            <Path x:Name="check" Width="10" Height="8" Stretch="Fill"
                                  Fill="{StaticResource AccentBrush}" Opacity="0"
                                  Data="M0,4 L3,7 L9,1" Stroke="{StaticResource AccentBrush}"
                                  StrokeThickness="1.6" StrokeLineJoin="Round"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="8,0,0,0"
                                          VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource NeuInset}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource NeuBezelPress}"/>
                            <Setter TargetName="box" Property="Effect" Value="{x:Null}"/>
                            <Setter TargetName="check" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource NeuSurfaceHi}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource NeuBezelHi}"/>
                            <Setter TargetName="box" Property="Effect" Value="{StaticResource NeuShadowFloat}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 幽灵图标按钮：无边框 MDL2 图标，未激活与背景融合，悬停光亮（全局，供 MainWindow / McpPanel / 各浮层共用）。
         注意：Content 必须是 Segoe Fluent Icons 字形（如 &#xE8BB; 关闭），普通字符（✕ 等）不在该字体内会渲染成方框。 -->
    <Style x:Key="IconBtn" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="4,0,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource NeuRadius6}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                            <Setter Property="Foreground" Value="{StaticResource MainBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="IconBtnDanger" TargetType="Button" BasedOn="{StaticResource IconBtn}">
        <Setter Property="Foreground" Value="#968C8C"/>
    </Style>

    <!-- 分框标题栏右侧动作按钮（全局，供主窗口项目组集群 / 设置面板图标分组共用）：图标色更淡，悬停时变亮 -->
    <Style x:Key="BoxActionBtn" TargetType="Button">
        <Setter Property="Foreground" Value="#2E333D"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="{StaticResource NeuRadius5}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#2A3140"/>
                            <Setter Property="Foreground" Value="#6B7482"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- BoxActionBtn 的 ToggleButton 版本（全局，供项目卡片"展开/收起链接的项目组"按钮使用，与 BoxActionBtn 同底同色） -->
    <Style x:Key="BoxActionToggleBtn" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="#2E333D"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="{StaticResource NeuRadius5}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#2A3140"/>
                            <Setter Property="Foreground" Value="#6B7482"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 极简外凸小按钮（记录面板 / MCP 面板 / 设置面板 / 色盘弹窗等共用）。
         ★ 小按钮统一规格唯一出处：高度 28 / 字号 12 / 内边距 10,0 —— 改这里全局生效，勿在使用处散落覆盖。
         MiniAccent（主操作）/ MiniDanger（危险操作）仅覆盖前景色，自动继承本规格。 -->
    <Style x:Key="MiniGhost" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource NeuSurfaceGrad}"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NeuBezel}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Effect" Value="{StaticResource NeuShadowSmall}"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            Effect="{TemplateBinding Effect}" CornerRadius="{StaticResource NeuRadius4}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource NeuSurfaceHiGrad}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeuBezelHi}"/>
                            <Setter TargetName="bd" Property="Effect" Value="{StaticResource NeuShadowFloat}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource NeuInset}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeuBezelPress}"/>
                            <Setter TargetName="bd" Property="Effect" Value="{x:Null}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MiniAccent" TargetType="Button" BasedOn="{StaticResource MiniGhost}">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style x:Key="MiniDanger" TargetType="Button" BasedOn="{StaticResource MiniGhost}">
        <Setter Property="Foreground" Value="#E5484D"/>
    </Style>

    <!-- 通用小按钮（深色描边） -->
    <Style x:Key="GhostBtn" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource NeuSurfaceGrad}"/>
        <Setter Property="Foreground" Value="{StaticResource MainBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NeuBezel}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Effect" Value="{StaticResource NeuShadowSmall}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            Effect="{TemplateBinding Effect}" CornerRadius="{StaticResource NeuRadius6}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource NeuSurfaceHiGrad}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeuBezelHi}"/>
                            <Setter TargetName="bd" Property="Effect" Value="{StaticResource NeuShadowFloat}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource NeuInset}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeuBezelPress}"/>
                            <Setter TargetName="bd" Property="Effect" Value="{x:Null}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主操作：分配项目（蓝，新拟物外凸） -->
    <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    </Style>

    <!-- 危险操作：取消分配（红，新拟物外凸） -->
    <Style x:Key="RedBtn" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#E5484D"/>
        <Setter Property="BorderBrush" Value="#E5484D"/>
    </Style>

    <!-- 标题栏按钮：软键三态下凹深度——常态凸起(NeuSurfaceGrad+NeuShadowSmall)，悬浮中下凹(#232630+细内影)，按下最深(NeuInset+NeuShadowInner)。覆盖 GhostBtn 模板以该深度模型替代原"悬浮浮起 + 按下去影" -->
    <Style x:Key="TitleBtn" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="4,0,0,0"/>
        <Setter Property="Background" Value="{StaticResource NeuSurfaceGrad}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NeuBezel}"/>
        <Setter Property="Effect" Value="{StaticResource NeuShadowSmall}"/>
        <!-- 软键三态下凹深度：常态凸起 / 悬浮中下凹 / 按下最深 -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource NeuRadius6}" Padding="{TemplateBinding Padding}"
                        Effect="{TemplateBinding Effect}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 悬浮：一点点下凹（中），替代原来的抬升浮起 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FF1F222B"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeuBezelHi}"/>
                            <Setter TargetName="bd" Property="Effect" Value="{StaticResource NeuShadowInsetHover}"/>
                        </Trigger>
                        <!-- 按下：最深下凹 -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FF191B21"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeuBezelPress}"/>
                            <Setter TargetName="bd" Property="Effect" Value="{StaticResource NeuShadowInsetPress}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 标题栏按钮·开启态（最浅下凹）：底色仅比常态略暗 + 细内影 + 高亮描边；悬浮/按下更深，走 TitleBtn 同一模板 -->
    <Style x:Key="TitleBtnActive" TargetType="Button" BasedOn="{StaticResource TitleBtn}">
        <Setter Property="Background" Value="#FF232631"/>
        <Setter Property="BorderBrush" Value="{StaticResource NeuBezelHi}"/>
        <Setter Property="Effect" Value="{StaticResource NeuShadowActive}"/>
    </Style>

    <!-- 收藏类型切换（项目组 / 项目） -->
    <Style x:Key="ModeToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource NeuRadius6}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#18FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource NeuSurfaceHi}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeuBezelHi}"/>
                            <Setter TargetName="bd" Property="BorderThickness" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 书签式项目页签：未选中=项目框下方独立小片；选中=与项目框同色、无上间隙、无顶边，连为一体 -->
    <Style x:Key="TabChip" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Padding="11,5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource NeuSurfaceGrad}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource NeuBezel}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="CornerRadius" Value="{StaticResource NeuRadius7}"/>
                                <Setter Property="Margin" Value="0,6,6,0"/>
                                <Setter Property="Effect" Value="{StaticResource NeuShadowSmall}"/>
                            </Style>
                        </Border.Style>
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource NeuSurfaceHi}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeuBezelHi}"/>
                            <Setter TargetName="bd" Property="Effect" Value="{StaticResource NeuShadowFloat}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource NeuInset}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeuBezelPress}"/>
                            <Setter TargetName="bd" Property="Effect" Value="{x:Null}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource CardBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeuBezel}"/>
                            <Setter TargetName="bd" Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter TargetName="bd" Property="CornerRadius" Value="0,0,7,7"/>
                            <Setter TargetName="bd" Property="Margin" Value="0,-1,6,0"/>
                            <Setter TargetName="bd" Property="Effect" Value="{x:Null}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource MainBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 页签上的关闭按钮：小幽灵 ×，悬停变红 -->
    <Style x:Key="TabCloseBtn" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="4,0,0,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource NeuRadius4}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#3A2A2A"/>
                            <Setter Property="Foreground" Value="#EF4444"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#4A3030"/>
                            <Setter Property="Foreground" Value="#FF6B6B"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 分框标题栏：整宽凹陷横条，作为该分框内容的标题（非独立按钮） -->
    <Style x:Key="BoxTitle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource NeuInset}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NeuBezelPress}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="CornerRadius" Value="8,8,0,0"/>
        <Setter Property="Padding" Value="11,5"/>
    </Style>

    <!-- 添加项目组集群虚线框默认描边：左上略亮、右下略暗（比面板亮，仍清晰可见） -->
    <LinearGradientBrush x:Key="AddBoxDashBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF5C6678" Offset="0.0"/>
        <GradientStop Color="#FF515A6B" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- 添加项目组集群虚线框高亮描边：强调蓝降半亮，避免悬停过亮 -->
    <SolidColorBrush x:Key="AddBoxDashHoverBrush" Color="#FF2F4E80"/>

    <!-- 虚线「添加项目组集群」按钮：与分框同宽，置于分框列表最底部 -->
    <Style x:Key="AddBoxBtn" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="{StaticResource NeuRadius8}" Background="Transparent">
                        <Grid>
                            <Rectangle x:Name="dashedRect" Stroke="{StaticResource AddBoxDashBrush}" StrokeThickness="1"
                                       StrokeDashArray="4,3" RadiusX="7" RadiusY="7"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="dashedRect" Property="Stroke" Value="{StaticResource AddBoxDashHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="dashedRect" Property="Stroke" Value="{StaticResource AddBoxDashHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 编辑列表（幽灵按钮切换的页签/分框管理面板）小铅笔按钮。
         特意不 BasedOn SidebarBtn：SidebarBtn 带「收起侧边栏时加大内边距」的样式触发器，
         会顺带把这里按钮（项目管理/项目组管理）在侧边栏收起时撑宽、展开时缩窄，
         造成按钮左右跳动——故自包含完整样式，内边距恒定。 -->
    <Style x:Key="GhostEditBtn" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="7,5"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource NeuRadius6}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                            <Setter Property="Foreground" Value="{StaticResource MainBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EditListPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource NeuSurfaceGrad}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NeuBezelHi}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource NeuRadius10}"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Effect" Value="{StaticResource NeuShadowSmall}"/>
        <Setter Property="Width" Value="280"/>
    </Style>

    <Style x:Key="EditListDelBtn" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource NeuRadius4}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#22FF6A6A"/>
                            <Setter Property="Foreground" Value="#E58A8A"/>
                        </Trigger>
                        <!-- 统一禁用态：置灰、箭头光标、无悬停反馈 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="Transparent"/>
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                            <Setter Property="Foreground" Value="#C96A6A"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 深色输入框：绑定 TargetPath -->
    <Style x:Key="InputBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource NeuInset}"/>
        <Setter Property="Foreground" Value="{StaticResource MainBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NeuBezelPress}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="9,5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
    </Style>

    <!-- 预览框：内凹承载区，自定义模板去掉悬浮/聚焦时的默认蓝色高亮边框 -->
    <Style x:Key="PreviewBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource NeuInset}"/>
        <Setter Property="Foreground" Value="{StaticResource MainBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NeuBezelPress}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="IsUndoEnabled" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource NeuRadius6}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="false"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 纵向分隔条：透明细条，悬停/拖动时显示亮灰色高亮线（用于三栏宽度调整）。
         ShowsPreview 必须为 False：True 时 WPF 只画黑色预览线、松手才落位；False=拖动实时调整列宽。 -->
    <Style x:Key="VSplitter" TargetType="GridSplitter">
        <Setter Property="Width" Value="3"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="ShowsPreview" Value="False"/>
        <Setter Property="Cursor" Value="SizeWE"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="Transparent" Margin="-7,0">
                        <Rectangle x:Name="line" Width="2" HorizontalAlignment="Center"
                                   Fill="Transparent" RadiusX="1" RadiusY="1"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="line" Property="Fill" Value="{StaticResource LineHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="line" Property="Fill" Value="{StaticResource LineActiveBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 横向分隔条：用于三栏主区与底部日志/预览区高度调整（ShowsPreview=False 同纵向条，拖动实时落位） -->
    <Style x:Key="HSplitter" TargetType="GridSplitter">
        <Setter Property="Height" Value="3"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="ShowsPreview" Value="False"/>
        <Setter Property="Cursor" Value="SizeNS"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="Transparent" Margin="0,-7">
                        <Rectangle x:Name="line" Height="2" VerticalAlignment="Center"
                                   Fill="Transparent" RadiusX="1" RadiusY="1"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="line" Property="Fill" Value="{StaticResource LineHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="line" Property="Fill" Value="{StaticResource LineActiveBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 浮层底边分隔条（无亮线）：仅保留命中区与光标，不显示悬停/拖动高亮线 -->
    <Style x:Key="HSplitterNoLine" TargetType="GridSplitter" BasedOn="{StaticResource HSplitter}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="Transparent" Margin="0,-7"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 深色滚动条（新拟物：内凹透明轨道 + 外凸滑块） ============ -->
    <!-- 轨道两端页滚动透明按钮 -->
    <Style x:Key="SBPageBtn" TargetType="RepeatButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 垂直滑块：外凸，悬停亮灰、拖动亮灰偏白 -->
    <Style x:Key="SBThumbV" TargetType="Thumb">
        <Setter Property="Width" Value="8"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="1,0"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="tb" CornerRadius="{StaticResource NeuRadius4}" Background="{StaticResource NeuSurfaceHi}"
                            BorderBrush="{StaticResource NeuBezel}" BorderThickness="1"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="tb" Property="Background" Value="{StaticResource LineHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="tb" Property="Background" Value="{StaticResource LineActiveBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 水平滑块 -->
    <Style x:Key="SBThumbH" TargetType="Thumb">
        <Setter Property="Height" Value="8"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="tb" CornerRadius="{StaticResource NeuRadius4}" Background="{StaticResource NeuSurfaceHi}"
                            BorderBrush="{StaticResource NeuBezel}" BorderThickness="1"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="tb" Property="Background" Value="{StaticResource LineHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="tb" Property="Background" Value="{StaticResource LineActiveBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 垂直滚动条模板 -->
    <ControlTemplate x:Key="VScrollBar" TargetType="ScrollBar">
        <Grid Background="#08FFFFFF">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SBPageBtn}" Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource SBThumbV}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SBPageBtn}" Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>
    <!-- 水平滚动条模板 -->
    <ControlTemplate x:Key="HScrollBar" TargetType="ScrollBar">
        <Grid Background="#08FFFFFF">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SBPageBtn}" Command="ScrollBar.PageLeftCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource SBThumbH}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SBPageBtn}" Command="ScrollBar.PageRightCommand"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <!-- 全局隐式：默认垂直，Orientation 切换水平 -->
    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Template" Value="{StaticResource VScrollBar}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Template" Value="{StaticResource HScrollBar}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- 全局 ToolTip：缩短悬停弹出延迟，横向切换无缓冲；随新拟物深色风格 -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource NeuInset}"/>
        <Setter Property="Foreground" Value="{StaticResource MainBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NeuBezelPress}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,5"/>
    </Style>
</ResourceDictionary>
