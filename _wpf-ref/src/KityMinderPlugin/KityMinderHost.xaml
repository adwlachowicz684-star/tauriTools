<UserControl x:Class="KityMinderPlugin.KityMinderHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
             d:DesignWidth="900" d:DesignHeight="560">
    <!-- 自包含控件：无任何对调用方资源字典的依赖，样式全部内联，可直接嵌入任意 WPF 窗体 -->
    <Grid>
        <!-- WebView2 承载区：圆角与 DarkFrame(8) 一致；网页自身不透明圆角+描边勾勒弧线，见 index.html -->
        <Border Background="#FF1B1B1F" BorderBrush="#FF3D4250"
                BorderThickness="1" CornerRadius="{StaticResource NeuRadius8}" ClipToBounds="True">
            <Grid>
                <views:WebView2 x:Name="Web" DefaultBackgroundColor="#FF1B1B1F"/>
                <!-- 加载遮罩：圆角与承载区一致，方形会盖住弧线 -->
                <Border x:Name="Loading" Background="#E61B1B1F" CornerRadius="{StaticResource NeuRadius8}" ClipToBounds="True" Visibility="Visible">
                    <TextBlock Text="思维导图加载中…" Foreground="#FFAFAFAF" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <!-- 状态（底部居中，就绪/异常反馈） -->
                <TextBlock x:Name="Status" Text="" Foreground="#FFD8D8D8" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>