<Window x:Class="FenPeiXiangMuZu.Portable.MarkdownEditor.MarkdownEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Markdown 编辑器"
        Width="1180" Height="760"
        MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize"
        AllowDrop="True"
        Drop="OnDrop"
        DragOver="OnDragOver"
        PreviewKeyDown="OnPreviewKeyDown"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">

    <Window.Resources>
        <!-- 半独立工具栏/编辑样式：仅依赖宿主主题同名 DynamicResource 键，
             缺失时回退到本地内置色，保证整窗在任何 WPF 暗色工程中都能独立工作。 -->
        <SolidColorBrush x:Key="L.Bar"  Color="#FF262931"/>
        <SolidColorBrush x:Key="L.Card" Color="#FF2A2E37"/>
        <SolidColorBrush x:Key="L.Hi"   Color="#FF353A45"/>
        <SolidColorBrush x:Key="L.Main" Color="#FFECEDF0"/>
        <SolidColorBrush x:Key="L.Mut"  Color="#FF9AA0AA"/>
        <SolidColorBrush x:Key="L.Brd"  Color="#FF38404B"/>
        <SolidColorBrush x:Key="L.Ins"  Color="#FF1C1F25"/>
        <SolidColorBrush x:Key="L.Acc"  Color="#FF5D9BFF"/>

        <Style x:Key="MdBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MainBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource NeuRadius5}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource ChipRowHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource NeuAccentTint}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MdBtnHi" TargetType="Button" BasedOn="{StaticResource MdBtn}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>

        <Style x:Key="ModeBtn" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource NeuRadius5}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource ChipRowHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource MainBrush}"/>
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource NeuAccentTint}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Sep" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid Margin="12">
        <Border CornerRadius="{StaticResource NeuRadius8}" Background="{DynamicResource NeuSurface}"
                BorderBrush="{DynamicResource NeuBezel}" BorderThickness="1"
                Effect="{DynamicResource NeuShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 标题栏：与宿主其它弹窗同款（BarBrush 圆角顶条 + 关闭钮 + 拖动） -->
                <Border x:Name="TitleBar" Grid.Row="0" Height="38"
                        Background="{DynamicResource BarBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1" CornerRadius="8,8,0,0"
                        MouseLeftButtonDown="OnTitleBarDrag">
                    <Grid>
                        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Foreground="{DynamicResource MainBrush}" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="14,0,42,0" TextTrimming="CharacterEllipsis"/>
                        <Button Click="OnTitleBarClose" Style="{DynamicResource IconBtn}" Content="&#xE8BB;"
                                ToolTip="关闭" Width="32" Height="32"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    </Grid>
                </Border>

                <!-- 内容区：工具栏 / 编辑预览 / 状态栏 -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Background="{DynamicResource BarBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="6,5">
            <WrapPanel>
                <Button Style="{StaticResource MdBtn}" Content="打开" ToolTip="打开 .md 文件 (Ctrl+O)" Click="OnOpen"/>
                <Button Style="{StaticResource MdBtn}" Content="保存" ToolTip="保存到当前文件 (Ctrl+S)" Click="OnSave"/>
                <Button Style="{StaticResource MdBtn}" Content="另存为…" ToolTip="另存为新文件" Click="OnSaveAs"/>
                <Border Style="{StaticResource Sep}"/>
                <Button Style="{StaticResource MdBtn}" Content="↶ 撤销" ToolTip="撤销 (Ctrl+Z)" Click="OnUndo"/>
                <Button Style="{StaticResource MdBtn}" Content="↷ 重做" ToolTip="重做 (Ctrl+Y)" Click="OnRedo"/>
                <Border Style="{StaticResource Sep}"/>
                <Button Style="{StaticResource MdBtnHi}" Content="H1" ToolTip="一级标题" Click="OnH1"/>
                <Button Style="{StaticResource MdBtnHi}" Content="H2" ToolTip="二级标题" Click="OnH2"/>
                <Button Style="{StaticResource MdBtnHi}" Content="H3" ToolTip="三级标题" Click="OnH3"/>
                <Button Style="{StaticResource MdBtnHi}" Content="B" ToolTip="加粗 (Ctrl+B)" Click="OnBold"/>
                <Button Style="{StaticResource MdBtn}" Content="I" ToolTip="斜体" Click="OnItalic"/>
                <Button Style="{StaticResource MdBtn}" Content="S" ToolTip="删除线" Click="OnStrike"/>
                <Button Style="{StaticResource MdBtn}" Content="`代码`" ToolTip="行内代码" Click="OnCode"/>
                <Button Style="{StaticResource MdBtn}" Content="引用" ToolTip="引用" Click="OnQuote"/>
                <Border Style="{StaticResource Sep}"/>
                <Button Style="{StaticResource MdBtn}" Content="• 列表" ToolTip="无序列表" Click="OnUl"/>
                <Button Style="{StaticResource MdBtn}" Content="1. 列表" ToolTip="有序列表" Click="OnOl"/>
                <Button Style="{StaticResource MdBtn}" Content="表格" ToolTip="插入表格" Click="OnTable"/>
                <Button Style="{StaticResource MdBtn}" Content="代码块" ToolTip="插入围栏代码块" Click="OnFence"/>
                <Button Style="{StaticResource MdBtn}" Content="链接" ToolTip="插入链接" Click="OnLink"/>
                <Button Style="{StaticResource MdBtn}" Content="图片" ToolTip="插入图片" Click="OnImage"/>
                <Border Style="{StaticResource Sep}"/>
                <ToggleButton x:Name="ModeSplit" Style="{StaticResource ModeBtn}" Content="分栏" IsChecked="True"
                              ToolTip="左编辑右预览" Click="OnModeSplit"/>
                <ToggleButton x:Name="ModeEdit" Style="{StaticResource ModeBtn}" Content="编辑" ToolTip="仅编辑"
                              Click="OnModeEdit"/>
                <ToggleButton x:Name="ModePreview" Style="{StaticResource ModeBtn}" Content="预览" ToolTip="仅预览"
                              Click="OnModePreview"/>
                <Border Style="{StaticResource Sep}"/>
                <ToggleButton x:Name="SyncLineBtn" Style="{StaticResource ModeBtn}" Content="行号同步" IsChecked="True"
                              Click="OnSyncLine" ToolTip="行号锚定：左右逐行对齐（块内近似）"/>
                <ToggleButton x:Name="SyncBlockBtn" Style="{StaticResource ModeBtn}" Content="块级同步"
                              Click="OnSyncBlock" ToolTip="块级语义：只对齐 Markdown 块起点"/>
            </WrapPanel>
        </Border>

        <!-- 编辑 / 预览 -->
        <Grid Grid.Row="1" x:Name="BodyGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColEditor" Width="*" MinWidth="260"/>
                <ColumnDefinition x:Name="ColSplit" Width="6"/>
                <ColumnDefinition x:Name="ColPreview" Width="*" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" x:Name="EditorHost" Background="{DynamicResource NeuInset}">
                <TextBox x:Name="Editor"
                         AcceptsReturn="True" AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         BorderThickness="0" Padding="12,10"
                         FontFamily="Consolas" FontSize="14" TextWrapping="Wrap"
                         SpellCheck.IsEnabled="False"
                         Background="Transparent" Foreground="{DynamicResource MainBrush}"
                         CaretBrush="{DynamicResource AccentBrush}"
                         SelectionBrush="#30648CE0"
                         TextChanged="OnEditorTextChanged"/>
            </Border>

            <GridSplitter Grid.Column="1" x:Name="Splitter" Width="6" HorizontalAlignment="Stretch"
                          Background="Transparent" ShowsPreview="False" Cursor="SizeWE"/>

            <Border Grid.Column="2" x:Name="PreviewHost" Background="{DynamicResource GuideBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                <FlowDocumentScrollViewer x:Name="Preview" IsToolBarVisible="False"
                                          VerticalScrollBarVisibility="Auto"/>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="{DynamicResource BarBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="8,3">
            <Grid>
                <TextBlock x:Name="LblFile" Foreground="{DynamicResource MutedBrush}" Text="未命名.md"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <TextBlock x:Name="LblDirty" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"
                               VerticalAlignment="Center" Text="" Visibility="Collapsed"/>
                    <TextBlock x:Name="LblCount" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Text="0 字符"/>
                    <TextBlock Text="  ·  " Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LblPos" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Text="行 1, 列 1"/>
                </StackPanel>
            </Grid>
        </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>

        <!-- 窗口边缘拖拽调整大小（无边框透明窗无系统 resize 边，自实现） -->
        <Border HorizontalAlignment="Left"           VerticalAlignment="Stretch" Width="6" Tag="L"  Cursor="SizeWE"
                Background="#01000000" MouseLeftButtonDown="ResizeMouseDown"/>
        <Border HorizontalAlignment="Right"          VerticalAlignment="Stretch" Width="6" Tag="R"  Cursor="SizeWE"
                Background="#01000000" MouseLeftButtonDown="ResizeMouseDown"/>
        <Border HorizontalAlignment="Stretch"        VerticalAlignment="Top"    Height="6" Tag="T"  Cursor="SizeNS"
                Background="#01000000" MouseLeftButtonDown="ResizeMouseDown"/>
        <Border HorizontalAlignment="Stretch"        VerticalAlignment="Bottom" Height="6" Tag="B"  Cursor="SizeNS"
                Background="#01000000" MouseLeftButtonDown="ResizeMouseDown"/>
        <Border HorizontalAlignment="Left"  VerticalAlignment="Top"    Width="12" Height="12" Tag="LT" Cursor="SizeNWSE"
                Background="#01000000" MouseLeftButtonDown="ResizeMouseDown"/>
        <Border HorizontalAlignment="Right" VerticalAlignment="Top"    Width="12" Height="12" Tag="RT" Cursor="SizeNESW"
                Background="#01000000" MouseLeftButtonDown="ResizeMouseDown"/>
        <Border HorizontalAlignment="Left"  VerticalAlignment="Bottom" Width="12" Height="12" Tag="LB" Cursor="SizeNESW"
                Background="#01000000" MouseLeftButtonDown="ResizeMouseDown"/>
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="12" Height="12" Tag="RB" Cursor="SizeNWSE"
                Background="#01000000" MouseLeftButtonDown="ResizeMouseDown"/>
    </Grid>
</Window>