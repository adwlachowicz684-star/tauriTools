{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "允许启动 traecli / codebuddy 并接收流式输出",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "traecli", "cmd": "traecli", "args": true },
        { "name": "codebuddy", "cmd": "codebuddy", "args": true },
        { "name": "cbc", "cmd": "cbc", "args": true }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "traecli", "cmd": "traecli", "args": true },
        { "name": "codebuddy", "cmd": "codebuddy", "args": true },
        { "name": "cbc", "cmd": "cbc", "args": true }
      ]
    },
    "shell:allow-kill"
  ]
}
