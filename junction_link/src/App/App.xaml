<Application x:Class="FenPeiXiangMuZu.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:FenPeiXiangMuZu.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 深色新拟物统一主题：全部调色板/表面/描边/阴影/按钮/页签/面板/滚动条等样式唯一出处。
                     改主题只改 Themes/NeuTheme.xaml，勿在此处散落样式。 -->
                <ResourceDictionary Source="Themes/NeuTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 全局显隐转换器：必须放 App 级——分离视觉树（ContextMenu/ToolTip 内的模板延迟段）解析 StaticResource 时
                 无法回溯 UserControl/Window 的局部字典，只能命中 App.Resources。
                 实锤：AgentSkillPanel 右键菜单(ContextMenu 内 MenuItem)引用局部 BoolToVis → 运行时 XamlParseException 连环崩 -->
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <!-- 按钮快捷键提示显隐：ShowShortcuts 开 &amp;&amp; 文本非空 &amp;&amp;（可选）展开态 -->
            <conv:ShortcutHintVisibilityConverter x:Key="ShortcutHintVis"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
