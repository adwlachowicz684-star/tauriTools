<UserControl x:Class="FenPeiXiangMuZu.Controls.SidebarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="64" d:DesignHeight="400">
    <UserControl.Resources>
        <!-- 侧边栏图标字形：居中加大图标 -->
        <Style x:Key="SideIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- 名称浮层项：名称文字取浅色固定（浮层为半透明深色底） -->
        <Style x:Key="SidePopupName" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
        </Style>
        <!-- 名称浮层快捷键：等宽小字浅灰；Shortcut 为 null 时折叠 -->
        <Style x:Key="SidePopupShortcut" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#FF8992A5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Text" Value="{Binding Shortcut}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Shortcut}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 侧边栏图标按钮基础样式：必须先于所有 BasedOn SidebarBtn 的样式定义 -->
        <Style x:Key="SidebarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,14,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource NeuRadius6}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource MainBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="Transparent"/>
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 数据驱动侧边栏图标按钮：危险项红色；Separator 项折叠（以分隔线展示） -->
        <Style x:Key="SidebarItemBtn" TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDanger}" Value="True">
                    <Setter Property="Foreground" Value="#C96A6A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Separator">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 图标列分隔线：仅 Separator 项显示 -->
        <Style x:Key="SidebarIconSeparator" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Margin" Value="4,14,4,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Separator">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 名称列分隔线：仅 Separator 项显示 -->
        <Style x:Key="SidebarNameSeparator" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Margin" Value="0,14,0,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Separator">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 名称列内容行：Kind=Separator 折叠；IsHovered 时半透明高亮（与图标列同实例联动） -->
        <Style x:Key="SidePopupRow" TargetType="Border">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,14,0,0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Separator">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHovered}" Value="True">
                    <Setter Property="Background" Value="#22FFFFFF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 侧边栏顶部切换按钮：始终居中加大图标；点击仅常驻模式生效（临时模式由鼠标悬停控制） -->
        <Style x:Key="SidebarToggleBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- 图标条：始终窄宽不变（居中加大图标），名称/快捷键移至右侧名称浮层显示。
             DockPanel 支持 BottomAnchor 分两组：常规项靠上，底部锚定项由下向上排（顺序不变）。 -->
        <Border x:Name="IconBar" Background="{DynamicResource BarBrush}" CornerRadius="{StaticResource NeuRadius6}"
                Padding="10,12,10,12" MouseEnter="OnSidebarMouseEnter" MouseLeave="OnSidebarMouseLeave">
            <DockPanel LastChildFill="False">
                <Button Content="&#xE700;" Style="{StaticResource SidebarToggleBtn}" Click="OnToggleSidebar" ToolTip="展开 / 收起侧边栏" DockPanel.Dock="Top"/>
                <ItemsControl x:Name="sidebarIconListTop" DockPanel.Dock="Top" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Border Style="{StaticResource SidebarIconSeparator}"/>
                                <Button Style="{StaticResource SidebarItemBtn}"
                                        Click="OnSidebarItemClick" MouseEnter="OnSidebarIconEnter" MouseLeave="OnSidebarIconLeave"
                                        ContextMenu="{Binding Menu}"
                                        ToolTip="{Binding ToolTip}">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource SideIcon}"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl x:Name="sidebarIconListBottom" DockPanel.Dock="Bottom" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Border Style="{StaticResource SidebarIconSeparator}"/>
                                <Button Style="{StaticResource SidebarItemBtn}"
                                        Click="OnSidebarItemClick" MouseEnter="OnSidebarIconEnter" MouseLeave="OnSidebarIconLeave"
                                        ContextMenu="{Binding Menu}"
                                        ToolTip="{Binding ToolTip}">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource SideIcon}"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- 名称浮层（Popup 自包含）：常驻模式=切换按钮控制显隐；临时模式=鼠标悬停图标条时浮出。
             与图标列绑定同一 SidebarItems，逐行同构对齐；IsHitTestVisible=false 不拦截鼠标。 -->
        <Popup x:Name="NamePopup" Placement="Right" PlacementTarget="{Binding ElementName=IconBar}"
               AllowsTransparency="True" IsHitTestVisible="False" Focusable="False" StaysOpen="True"
               HorizontalOffset="-6" VerticalOffset="-8">
            <Border Margin="8" Background="Transparent">
                <Border Margin="0,12,0,12" Padding="8,0,8,0" CornerRadius="{StaticResource NeuRadius8}"
                        Effect="{StaticResource NeuShadowFloat}">
                    <Border.Background>
                        <!-- 左实右虚渐变：透明度从左到右递增 -->
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#CC141D28"/>
                            <GradientStop Offset="1" Color="#59141D28"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel LastChildFill="False">
                        <!-- 切换按钮占位（高30+底边距8），使名称列首行与图标列首个操作图标对齐 -->
                        <Border Height="38" DockPanel.Dock="Top"/>
                        <ItemsControl x:Name="sidebarNameListTop" DockPanel.Dock="Top" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Border Style="{StaticResource SidebarNameSeparator}"/>
                                        <Border Style="{StaticResource SidePopupRow}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource SidePopupName}"/>
                                                <TextBlock Style="{StaticResource SidePopupShortcut}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl x:Name="sidebarNameListBottom" DockPanel.Dock="Bottom" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Border Style="{StaticResource SidebarNameSeparator}"/>
                                        <Border Style="{StaticResource SidePopupRow}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource SidePopupName}"/>
                                                <TextBlock Style="{StaticResource SidePopupShortcut}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </Border>
        </Popup>
    </Grid>
</UserControl>
