<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 可复用 WPF 类库：自包含 kityminder 思维导图宿主控件（KityMinderHost）。
         消费者只需引用本 dll 并在界面放置 KityMinderHost 即可获得可编辑脑图。
         kityminder 的 Web 资源内嵌进本程序集，运行时自动释放到临时目录经虚拟主机同源加载。 -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>KityMinderPlugin</RootNamespace>
    <AssemblyName>KityMinderPlugin</AssemblyName>
    <!-- 中间/输出产物路径由本目录 Directory.Build.props 统一设置（独立英文目录，与主工程隔离），此处不内联。 -->
  </PropertyGroup>

  <!-- kityminder Web 资产内嵌：逻辑名统一加 kityminder. 前缀，运行期枚举并释放 -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\kityminder\**\*.*">
      <LogicalName>kityminder.%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

</Project>