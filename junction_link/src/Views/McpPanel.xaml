<UserControl x:Class="FenPeiXiangMuZu.Views.McpPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
              d:DesignWidth="800" d:DesignHeight="560">
    <UserControl.Resources>
        <!-- 单个分组卡片（左右两列共用，每列内部连续堆叠） -->
        <DataTemplate x:Key="GroupCardTemplate">
            <Border Background="{StaticResource NeuSurface}"
                    BorderBrush="{StaticResource NeuBezel}" BorderThickness="1"
                    Effect="{StaticResource NeuShadowSmall}" CornerRadius="{StaticResource NeuRadius8}"
                    Padding="14,12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}"
                               Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding Tools}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource CheckLabel}"
                                          IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,5">
                                    <StackPanel Margin="0,1">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitleMono}"/>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource SectionDesc}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 + 说明 + 右上角关闭 -->
        <Grid>
            <StackPanel Margin="0,0,40,0">
                <TextBlock Text="MCP 工具开关" Style="{StaticResource PanelTitle}"/>
                <TextBlock Text="勾选要暴露给 AI 客户端的工具，减少不需要的 MCP 对 AI 的占用。"
                           Style="{StaticResource SectionDesc}" Margin="0,4,0,10"/>
            </StackPanel>
            <Button Content="&#xE894;" Style="{StaticResource IconBtn}" HorizontalAlignment="Right"
                    VerticalAlignment="Top" ToolTip="关闭" Click="OnCloseClick"/>
        </Grid>

        <!-- 总开关 + 计数 + 全选/全不选 -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0" Style="{StaticResource CheckLabel}"
                      IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="启用 MCP 服务" Style="{StaticResource ItemTitle}"/>
            </CheckBox>
            <TextBlock Grid.Column="1" Text="{Binding Summary}" Style="{StaticResource SectionDesc}"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content="全选" Style="{StaticResource MiniGhost}"
                    Command="{Binding SelectAllCommand}" Margin="4,0,0,0" Padding="12,5" FontSize="14"/>
            <Button Grid.Column="3" Content="全不选" Style="{StaticResource MiniGhost}"
                    Command="{Binding SelectNoneCommand}" Margin="4,0,0,0" Padding="12,5" FontSize="14"/>
        </Grid>

        <!-- 分组工具列表：2 列卡片布局 -->
        <Border Grid.Row="2" Background="{StaticResource NeuInset}"
                BorderBrush="{StaticResource NeuBezelPress}" BorderThickness="1"
                Effect="{StaticResource NeuShadowInner}" CornerRadius="{StaticResource NeuRadius6}" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ItemsControl Grid.Column="0" ItemsSource="{Binding LeftGroups}"
                                  ItemTemplate="{StaticResource GroupCardTemplate}"
                                  Margin="0,0,5,0"/>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding RightGroups}"
                                  ItemTemplate="{StaticResource GroupCardTemplate}"
                                  Margin="5,0,0,0"/>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- 底部提示 -->
        <TextBlock Grid.Row="3" Text="改动即时保存；MCP 服务下次连接时按此开关只暴露已勾选工具。"
                   Style="{StaticResource Caption}" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
