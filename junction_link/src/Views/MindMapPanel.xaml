<UserControl x:Class="FenPeiXiangMuZu.Views.MindMapPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:plugin="clr-namespace:KityMinderPlugin;assembly=KityMinderPlugin"
             xmlns:local="clr-namespace:FenPeiXiangMuZu.Views"
             xmlns:app="clr-namespace:FenPeiXiangMuZu"
             mc:Ignorable="d"
             d:DesignWidth="900" d:DesignHeight="560">
    <UserControl.Resources>
        <!-- 底部画布标签按钮：选中态高亮（DataTrigger 放在最后，优先于悬浮态） -->
        <Style x:Key="SheetTabBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#FF98A2B3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,5,12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="58"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource NeuRadius5}"
                                Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF1C212B"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF242C3B"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF3A4457"/>
                                <Setter Property="Foreground" Value="#FFE9EDF4"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 右侧边栏分组标题 -->
        <Style x:Key="SegmentTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#AEB6C4"/>
            <Setter Property="Margin" Value="2,0,0,8"/>
        </Style>
        <!-- 样式页签主题标题：比 SegmentTitle 大一号，与下方内容间距更大（底部 8→20） -->
        <Style x:Key="SegmentTitleBig" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#AEB6C4"/>
            <Setter Property="Margin" Value="2,0,0,20"/>
        </Style>
        <!-- 幽灵文字按钮：无边框、仅文字（参考主界面 GhostEditBtn），VerticalAlignment=Top 与标题文字顶端对齐 -->
        <Style x:Key="GhostTextBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,4,8,4"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource NeuRadius4}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource MainBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 布局缩略图按钮：图片直显，选中描边高亮，悬浮显示名称（ToolTip，与 webview 外观页签模板一致） -->
        <Style x:Key="LayoutThumbBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Background" Value="#FF1B1B1F"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="#FF383840" BorderThickness="1" CornerRadius="{StaticResource NeuRadius6}" Padding="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF7FC2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#FF244B79"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 主题色块按钮：四扇区圆（左半=整图背景色，右上 1/4=中央节点色，右下 1/8=二级节点色，右下 1/8=子节点色），外圈选中描边 -->
        <Style x:Key="ThemeDotBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="1,0,8,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="ring" Width="34" Height="34" Stroke="Transparent" StrokeThickness="2"/>
                            <Grid Width="26" Height="26">
                                <!-- 底：整图背景色（左半圆即背景色） -->
                                <Ellipse Fill="{Binding Brush}"/>
                                <!-- 右上 1/4 圆：中央节点色 -->
                                <Ellipse Fill="{Binding RootBrush}">
                                    <Ellipse.Clip>
                                        <PathGeometry Figures="M13,13 L13,0 A13,13 0 0 1 26,13 Z"/>
                                    </Ellipse.Clip>
                                </Ellipse>
                                <!-- 右下 1/8 圆：二级节点色 -->
                                <Ellipse Fill="{Binding MainBrush}">
                                    <Ellipse.Clip>
                                        <PathGeometry Figures="M13,13 L26,13 A13,13 0 0 1 22.192,22.192 Z"/>
                                    </Ellipse.Clip>
                                </Ellipse>
                                <!-- 右下 1/8 圆：子节点色 -->
                                <Ellipse Fill="{Binding SubBrush}">
                                    <Ellipse.Clip>
                                        <PathGeometry Figures="M13,13 L22.192,22.192 A13,13 0 0 1 13,26 Z"/>
                                    </Ellipse.Clip>
                                </Ellipse>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="ring" Property="Stroke" Value="#FF7FC2FF"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ring" Property="Stroke" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 新 GUI 顶部栏工具按钮：深色描边 + hover/按下态，对齐面板配色 -->
        <Style x:Key="ToolBarBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#26262B"/>
            <Setter Property="Foreground" Value="#D9D9D9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="#383840"
                                BorderThickness="1" CornerRadius="{StaticResource NeuRadius6}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33333A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#244B79"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 顶部栏竖排按钮（上图标下文字，对齐 webview km-btn-item 图标+文字）：Content 用 StackPanel[图标,文字] -->
        <Style x:Key="ToolBarVBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="58"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="#26262B"/>
            <Setter Property="Foreground" Value="#D9D9D9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="#383840"
                                BorderThickness="1" CornerRadius="{StaticResource NeuRadius6}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33333A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#244B79"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 顶部栏数字方块按钮（优先级 P1-P9/清除、进度 1-9/清除） -->
        <!-- 顶栏边栏页签切换按钮：与工具栏按钮同款，选中态(IsChecked)高亮用于指示当前边栏页签 -->
        <Style x:Key="SideTabBtn" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#26262B"/>
            <Setter Property="Foreground" Value="#D9D9D9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="#383840"
                                BorderThickness="1" CornerRadius="{StaticResource NeuRadius6}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33333A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#244B79"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#4A90D9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolBarNumBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Background" Value="#26262B"/>
            <Setter Property="Foreground" Value="#D9D9D9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="#383840"
                                BorderThickness="1" CornerRadius="{StaticResource NeuRadius6}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33333A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#244B79"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 顶部栏分隔竖线 -->
        <Style x:Key="ToolBarSep" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Background" Value="#383840"/>
            <Setter Property="Margin" Value="8,2"/>
        </Style>
        <!-- 侧边栏深色下拉框（外观：字体/字号选择。面板局部、硬编码配色，与其他侧边栏控件一致） -->
        <Style x:Key="SideComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#D9D9D9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="#26262B" BorderBrush="#383840"
                                                BorderThickness="1" CornerRadius="{StaticResource NeuRadius6}">
                                            <Path HorizontalAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center"
                                                  Data="M7,10L12,15L17,10Z" Fill="#8A90A0" Width="12" Height="12" Stretch="Uniform"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#7FC2FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="10,0,28,0" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              VerticalAlignment="Center" TextBlock.Foreground="#D9D9D9"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                                   StaysOpen="False" PopupAnimation="Fade" MaxHeight="240">
                                <Border Background="#26262B" BorderBrush="#383840" BorderThickness="1"
                                        CornerRadius="{StaticResource NeuRadius6}" Margin="0,2,0,0" MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#D9D9D9"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#244B79"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#1B1B1F"/>
                                            <Setter Property="Foreground" Value="#7FC2FF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 搜索关键字输入框（深色，与侧边栏控件视觉一致） -->
        <Style x:Key="SearchInputBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#D9D9D9"/>
            <Setter Property="Background" Value="#26262B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CaretBrush" Value="#7FC2FF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="#383840"
                                BorderThickness="1" CornerRadius="{StaticResource NeuRadius6}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Stretch" HorizontalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#7FC2FF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#7FC2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 新 GUI 深色顶部栏（WebView 上方）：两排网格——左=思路功能（插入上级/下级、上移/下移、编辑/删除 上下成对；
             链接/图片/备注竖排跨两行；优先级、进度各自拆成上下两排），右=视图功能（展开级别/选择/搜索，靠右）；原生工具栏保留对照 -->
        <Border Grid.Row="0" Margin="0,0,0,8" Background="#FF101318" CornerRadius="{StaticResource NeuRadius8}"
                BorderThickness="1" BorderBrush="#FF2A2A30" Padding="12,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 思路标签（左上，跨两排） -->
                <TextBlock Grid.Row="0" Grid.RowSpan="2" Text="思路" Foreground="#8A90A0" FontSize="12"
                           VerticalAlignment="Top" Margin="2,5,12,0"/>

                <!-- 插入上级(上) / 插入下级(下)：上下对；插入同级独立占上排 -->
                <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource ToolBarBtn}" Content="插入上级" Padding="10,3"
                        Click="OnIdeaClick" Tag="appendparentnode" ToolTip="在选中节点上方插入上级主题"/>
                <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource ToolBarBtn}" Content="插入下级" Padding="10,3"
                        Click="OnIdeaClick" Tag="appendchildnode" ToolTip="在选中节点下插入下级主题"/>
                <Button Grid.Row="0" Grid.Column="3" Style="{StaticResource ToolBarBtn}" Content="插入同级" Padding="10,3"
                        Click="OnIdeaClick" Tag="appendsiblingnode" ToolTip="在选中节点旁插入同级主题"/>

                <!-- 上移 / 下移（上下对） -->
                <Button Grid.Row="0" Grid.Column="4" Style="{StaticResource ToolBarBtn}" Content="上移" Width="52" Padding="0"
                        Click="OnIdeaClick" Tag="arrangeup" ToolTip="将选中节点上移一位"/>
                <Button Grid.Row="1" Grid.Column="4" Style="{StaticResource ToolBarBtn}" Content="下移" Width="52" Padding="0"
                        Click="OnIdeaClick" Tag="arrangedown" ToolTip="将选中节点下移一位"/>

                <!-- 编辑 / 删除（上下对） -->
                <Button Grid.Row="0" Grid.Column="5" Style="{StaticResource ToolBarBtn}" Content="编辑" Width="52" Padding="0"
                        Click="OnIdeaClick" Tag="EditNode" ToolTip="编辑选中节点文字"/>
                <Button Grid.Row="1" Grid.Column="5" Style="{StaticResource ToolBarBtn}" Content="删除" Width="52" Padding="0"
                        Click="OnIdeaClick" Tag="removenode" ToolTip="删除选中节点"/>

                <!-- 链接 / 图片 / 备注 / 外框：竖排跨两行，上图标下文字（对齐 webview km-btn-item） -->
                <Button Grid.Row="0" Grid.Column="6" Grid.RowSpan="2" Margin="0,0,4,0"
                        Style="{StaticResource ToolBarVBtn}" Click="OnLinkClick"
                        ToolTip="为选中节点设置/移除超链接">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#D9D9D9" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBlock Text="链接" FontSize="11" Foreground="#D9D9D9" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="0" Grid.Column="7" Grid.RowSpan="2" Margin="0,0,4,0"
                        Style="{StaticResource ToolBarVBtn}" Click="OnImageClick"
                        ToolTip="为选中节点设置/移除图片">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#D9D9D9" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBlock Text="图片" FontSize="11" Foreground="#D9D9D9" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="0" Grid.Column="8" Grid.RowSpan="2" Margin="0,0,4,0"
                        Style="{StaticResource ToolBarVBtn}" Click="OnNoteClick"
                        ToolTip="为选中节点设置/移除备注">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#D9D9D9" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBlock Text="备注" FontSize="11" Foreground="#D9D9D9" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="0" Grid.Column="9" Grid.RowSpan="2" Margin="0,0,4,0"
                        Style="{StaticResource ToolBarVBtn}" Click="OnFileClick"
                        ToolTip="为选中节点附加/替换/移除文件">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#D9D9D9" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBlock Text="文件" FontSize="11" Foreground="#D9D9D9" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="0" Grid.Column="10" Grid.RowSpan="2"
                        Style="{StaticResource ToolBarVBtn}" Click="OnIdeaClick" Tag="boundary"
                        ToolTip="为选中节点添加/移除矩形外框">
                    <StackPanel VerticalAlignment="Center">
                        <Path Data="M1,1 L21,1 L21,21 L1,21 Z" Stroke="#D9D9D9" StrokeThickness="1.6" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBlock Text="外框" FontSize="11" Foreground="#D9D9D9" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="0" Grid.Column="11" Grid.RowSpan="2" Margin="0,0,4,0"
                        Style="{StaticResource ToolBarVBtn}" Click="OnVideoClick"
                        ToolTip="为选中节点插入/替换/移除视频">
                    <StackPanel VerticalAlignment="Center">
                        <Path Data="M2,1 L18,9 L2,17 Z" Fill="#D9D9D9" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBlock Text="视频" FontSize="11" Foreground="#D9D9D9" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 视图功能（按钮已移至左侧边栏；此处仅保留选择/搜索输入控件） -->
                <StackPanel Grid.Row="0" Grid.Column="12" Grid.RowSpan="2" Orientation="Horizontal"
                            VerticalAlignment="Center" HorizontalAlignment="Right">
                    <ComboBox x:Name="SelectBox" Style="{StaticResource SideComboBox}" Width="116" Margin="2,0,0,0"
                              SelectionChanged="OnSelectChanged" ToolTip="按范围选择节点">
                        <ComboBoxItem Content="选择" IsSelected="True"/>
                        <ComboBoxItem Content="全选" Tag="all"/>
                        <ComboBoxItem Content="反选" Tag="revert"/>
                        <ComboBoxItem Content="选择兄弟节点" Tag="siblings"/>
                        <ComboBoxItem Content="选择同级节点" Tag="level"/>
                        <ComboBoxItem Content="选择路径" Tag="path"/>
                        <ComboBoxItem Content="选择子树" Tag="tree"/>
                    </ComboBox>
                    <TextBox x:Name="SearchBox" Width="150" Margin="8,0,0,0" VerticalContentAlignment="Center"
                             Style="{StaticResource SearchInputBox}" Padding="8,4"
                             KeyDown="OnSearchKeyDown" ToolTip="输入关键字并回车，或点击右侧搜索按钮查找节点"/>
                    <Button Style="{StaticResource ToolBarBtn}" Content="搜索" Padding="12,5" Margin="2,0,0,0"
                            Click="OnSearchClick" ToolTip="搜索节点（输入框关键字，逐个循环定位）"/>
                </StackPanel>

                <!-- 边栏页签入口（最右侧）：主题 / 标签，点击切换右侧边栏对应页签 -->
                <StackPanel Grid.Row="0" Grid.Column="14" Grid.RowSpan="2" Orientation="Horizontal"
                            VerticalAlignment="Center" HorizontalAlignment="Right">
                    <ToggleButton x:Name="SideBtnTheme" Style="{StaticResource SideTabBtn}" Content="主题" Tag="theme"
                                  IsChecked="True" Click="OnSideTabClick"
                                  ToolTip="切换到布局/主题/外观页签"/>
                    <ToggleButton x:Name="SideBtnTag" Style="{StaticResource SideTabBtn}" Content="标签" Tag="tag"
                                  Click="OnSideTabClick" ToolTip="切换到优先级/进度页签"/>
                    <ToggleButton x:Name="SideBtnStyle" Style="{StaticResource SideTabBtn}" Content="样式" Tag="style"
                                  Click="OnSideTabClick" ToolTip="切换到主题样式/外观页签"/>
                    <ToggleButton x:Name="SideBtnFile" Style="{StaticResource SideTabBtn}" Content="文件" Tag="file"
                                  Click="OnSideTabClick" ToolTip="切换到文件附件/视频播放页签"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 脑图承载区：左=可复用宿主控件 + 未安装占位叠层，右=布局/主题边栏 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="276"/>
            </Grid.ColumnDefinitions>

            <!-- 画布区：内凹 DarkFrame 承载（去掉外层 Card，仅保留内凹） -->
            <Border Grid.Column="0" Style="{StaticResource DarkFrame}" Padding="0"
                    Margin="0,0,8,0">
                <Grid>
                    <plugin:KityMinderHost x:Name="Editor" StatusChanged="OnEditorStatus"/>
                    <Border x:Name="Empty" Background="#FF1B1B1F" CornerRadius="{StaticResource NeuRadius6}" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="思维导图组件尚未启用" Foreground="#CFCFCF" FontSize="15" HorizontalAlignment="Center"/>
                            <Button Content="立即启用" Style="{StaticResource MiniGhost}" Padding="18,7" Margin="0,14,0,0"
                                    HorizontalAlignment="Center" Click="OnInstallClick"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 右侧边栏：布局 + 主题（参考 XMind 样式/画布属性面板） -->
            <Border Grid.Column="1" Margin="8,0,0,0" Background="#FF101318" CornerRadius="{StaticResource NeuRadius8}" Padding="12,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                    <!-- 主题页签：布局 / 主题 / 主题样式 / 外观 -->
                    <StackPanel x:Name="SidePageTheme">
                        <TextBlock Text="布局" Style="{StaticResource SegmentTitle}"/>
                        <ItemsControl x:Name="layoutList" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource LayoutThumbBtn}" Click="OnLayoutClick"
                                            ToolTip="{Binding Label}" ToolTipService.InitialShowDelay="200">
                                        <Image Source="{Binding Thumb}" Width="100" Height="58" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="2,18,0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="主题" Style="{StaticResource SegmentTitle}" Margin="0,0,0,0"
                                       HorizontalAlignment="Left" Grid.RowSpan="2"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="编辑" Style="{StaticResource MiniGhost}" Padding="10,3"
                                        FontSize="12" Click="OnEditThemeClick" ToolTip="编辑当前选中的自定义主题" Margin="0,0,6,0"/>
                                <Button Content="删除" Style="{StaticResource MiniDanger}" Padding="10,3"
                                        FontSize="12" Click="OnDeleteThemeClick" ToolTip="删除当前选中的自定义主题"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                        Margin="0,6,0,0">
                                <Button Content="导入" Style="{StaticResource MiniGhost}" Padding="10,3"
                                        FontSize="12" Click="OnImportThemeClick" ToolTip="从 JSON 文件导入自定义主题" Margin="0,0,6,0"/>
                                <Button Content="导出" Style="{StaticResource MiniGhost}" Padding="10,3"
                                        FontSize="12" Click="OnExportThemeClick" ToolTip="导出当前选中的自定义主题为 JSON 文件" Margin="0,0,6,0"/>
                                <Button Content="＋ 新建" Style="{StaticResource MiniGhost}" Padding="12,3"
                                        FontSize="12" Click="OnNewThemeClick" ToolTip="新建并保存自定义主题"/>
                            </StackPanel>
                        </Grid>
                        <ItemsControl x:Name="themeList" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ThemeDotBtn}" Click="OnThemeClick"
                                            ToolTip="{Binding Label}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        </StackPanel>
                    <!-- 标签页签：优先级 / 进度（原顶栏分组搬移至此；按钮图标来自 webview 精灵图，由代码生成） -->
                    <StackPanel x:Name="SidePageTag" Visibility="Collapsed">
                        <TextBlock Text="优先级" Style="{StaticResource SegmentTitle}"/>
                        <StackPanel x:Name="PriorityHost" Focusable="False"/>
                        <TextBlock Text="进度" Style="{StaticResource SegmentTitle}" Margin="4,18,0,10"/>
                        <StackPanel x:Name="ProgressHost" Focusable="False"/>
                        <!-- 自定义图标：内嵌预设图标区（复用设置面板图标库，按分组展示；点选应用为节点图片）
                             下方提供清除图标 / 浏览本机图片 两个操作按钮 -->
                        <TextBlock Text="自定义图标" Style="{StaticResource SegmentTitle}" Margin="4,18,0,10"/>
                        <StackPanel x:Name="CustomIconHost" Focusable="False"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource ToolBarBtn}" Content="清除图标" Padding="12,6" Margin="0,0,8,0"
                                    Click="OnClearIconClick" ToolTip="移除选中节点的自定义图片"/>
                            <Button Style="{StaticResource ToolBarBtn}" Content="浏览图片..." Padding="12,6"
                                    Click="OnBrowseImageClick" ToolTip="从本机选择图片文件作为选中节点的图片"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- 样式页签：节点样式 + 外观（从原「主题」页签迁出） -->
                    <StackPanel x:Name="SidePageStyle" Visibility="Collapsed">
                        <!-- 文字分组：字体/字体色/字号/加粗/斜体/删除线/水平对齐/垂直对齐 -->
                        <Grid Margin="4,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="文字" Style="{StaticResource SegmentTitleBig}" VerticalAlignment="Top"/>
                            <Button Grid.Column="1" Content="清除样式" Style="{StaticResource GhostTextBtn}"
                                    Click="OnClearScopeClick" Tag="text" ToolTip="清除选中节点的文字样式"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="字体" Foreground="#AEB6C4" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox x:Name="fontBox" Grid.Column="1" Style="{StaticResource SideComboBox}"
                                      SelectionChanged="OnFontChanged" ToolTip="设置选中节点字体"/>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="字体色" Foreground="#AEB6C4" FontSize="12" VerticalAlignment="Center"/>
                            <Button x:Name="ForeBtn" Grid.Column="1" Style="{StaticResource ToolBarBtn}" Padding="10,6"
                                    Click="OnForeColorClick" ToolTip="设置选中节点文字颜色">
                                <Border x:Name="ForeSwatch" Width="18" Height="18" CornerRadius="{StaticResource NeuRadius3}" Background="#000000"/>
                            </Button>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="字号" Foreground="#AEB6C4" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="sizeBox" Width="96" Style="{StaticResource SideComboBox}"
                                          SelectionChanged="OnSizeChanged" PreviewMouseWheel="OnSizeMouseWheel"
                                          ToolTip="设置选中节点字号（滚轮切换档位）"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="BtnBold" Content="B" Style="{StaticResource ToolBarBtn}" Padding="0" Width="42" Height="28"
                                    FontWeight="Bold" Click="OnAppearanceClick" Tag="bold" ToolTip="加粗选中节点文字"/>
                            <Button x:Name="BtnItalic" Content="I" Style="{StaticResource ToolBarBtn}" Padding="0" Width="42" Height="28"
                                    FontStyle="Italic" Click="OnAppearanceClick" Tag="italic" ToolTip="斜体选中节点文字"/>
                            <Button x:Name="BtnStrike" Style="{StaticResource ToolBarBtn}" Padding="0" Width="42" Height="28"
                                    Click="OnAppearanceClick" Tag="strikethrough" ToolTip="删除线选中节点文字">
                                <TextBlock Text="S" TextDecorations="Strikethrough"/>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="BtnAlignL" Content="左" Style="{StaticResource ToolBarBtn}" Padding="0" Width="42" Height="28"
                                    Click="OnAppearanceClick" Tag="align-left" ToolTip="选中节点文字左对齐"/>
                            <Button x:Name="BtnAlignC" Content="中" Style="{StaticResource ToolBarBtn}" Padding="0" Width="42" Height="28"
                                    Click="OnAppearanceClick" Tag="align-center" ToolTip="选中节点文字居中对齐"/>
                            <Button x:Name="BtnAlignR" Content="右" Style="{StaticResource ToolBarBtn}" Padding="0" Width="42" Height="28"
                                    Click="OnAppearanceClick" Tag="align-right" ToolTip="选中节点文字右对齐"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="BtnValignT" Content="上" Style="{StaticResource ToolBarBtn}" Padding="0" Width="42" Height="28"
                                    Click="OnAppearanceClick" Tag="valign-top" ToolTip="选中节点文字靠上对齐"/>
                            <Button x:Name="BtnValignC" Content="中" Style="{StaticResource ToolBarBtn}" Padding="0" Width="42" Height="28"
                                    Click="OnAppearanceClick" Tag="valign-middle" ToolTip="选中节点文字垂直居中对齐"/>
                            <Button x:Name="BtnValignB" Content="下" Style="{StaticResource ToolBarBtn}" Padding="0" Width="42" Height="28"
                                    Click="OnAppearanceClick" Tag="valign-bottom" ToolTip="选中节点文字靠下对齐"/>
                        </StackPanel>
                        <!-- 垂直微调（临时调试）：3 层级(中心/一级/更深) × 3 对齐(靠上/居中/靠下)，拖滑块实时预览；确定位置后固化为默认规则并移除本面板 -->
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="垂直微调(临时)" Foreground="#AEB6C4" FontSize="12" Margin="2,0,0,5"/>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="层级" Foreground="#8B93A1" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="靠上" Foreground="#8B93A1" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="居中" Foreground="#8B93A1" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="靠下" Foreground="#8B93A1" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Text="中心节点" Foreground="#AEB6C4" FontSize="11" VerticalAlignment="Center"/>
                                <Slider x:Name="VoCenterTop" Grid.Row="1" Grid.Column="1" Tag="center|top" Margin="3,0" VerticalAlignment="Bottom"
                                        Minimum="-40" Maximum="40" Value="0" LargeChange="5" SmallChange="1" TickFrequency="5"
                                        IsMoveToPointEnabled="True" ValueChanged="OnValignOffsetChanged"/>
                                <Slider x:Name="VoCenterMid" Grid.Row="1" Grid.Column="2" Tag="center|middle" Margin="3,0" VerticalAlignment="Bottom"
                                        Minimum="-40" Maximum="40" Value="0" LargeChange="5" SmallChange="1" TickFrequency="5"
                                        IsMoveToPointEnabled="True" ValueChanged="OnValignOffsetChanged"/>
                                <Slider x:Name="VoCenterBtm" Grid.Row="1" Grid.Column="3" Tag="center|bottom" Margin="3,0" VerticalAlignment="Bottom"
                                        Minimum="-40" Maximum="40" Value="0" LargeChange="5" SmallChange="1" TickFrequency="5"
                                        IsMoveToPointEnabled="True" ValueChanged="OnValignOffsetChanged"/>
                                <TextBlock Grid.Row="2" Text="一级子节点" Foreground="#AEB6C4" FontSize="11" VerticalAlignment="Center"/>
                                <Slider x:Name="VoChildTop" Grid.Row="2" Grid.Column="1" Tag="child|top" Margin="3,0" VerticalAlignment="Bottom"
                                        Minimum="-40" Maximum="40" Value="0" LargeChange="5" SmallChange="1" TickFrequency="5"
                                        IsMoveToPointEnabled="True" ValueChanged="OnValignOffsetChanged"/>
                                <Slider x:Name="VoChildMid" Grid.Row="2" Grid.Column="2" Tag="child|middle" Margin="3,0" VerticalAlignment="Bottom"
                                        Minimum="-40" Maximum="40" Value="0" LargeChange="5" SmallChange="1" TickFrequency="5"
                                        IsMoveToPointEnabled="True" ValueChanged="OnValignOffsetChanged"/>
                                <Slider x:Name="VoChildBtm" Grid.Row="2" Grid.Column="3" Tag="child|bottom" Margin="3,0" VerticalAlignment="Bottom"
                                        Minimum="-40" Maximum="40" Value="0" LargeChange="5" SmallChange="1" TickFrequency="5"
                                        IsMoveToPointEnabled="True" ValueChanged="OnValignOffsetChanged"/>
                                <TextBlock Grid.Row="3" Text="更深节点" Foreground="#AEB6C4" FontSize="11" VerticalAlignment="Center"/>
                                <Slider x:Name="VoDeepTop" Grid.Row="3" Grid.Column="1" Tag="deep|top" Margin="3,0" VerticalAlignment="Bottom"
                                        Minimum="-40" Maximum="40" Value="0" LargeChange="5" SmallChange="1" TickFrequency="5"
                                        IsMoveToPointEnabled="True" ValueChanged="OnValignOffsetChanged"/>
                                <Slider x:Name="VoDeepMid" Grid.Row="3" Grid.Column="2" Tag="deep|middle" Margin="3,0" VerticalAlignment="Bottom"
                                        Minimum="-40" Maximum="40" Value="0" LargeChange="5" SmallChange="1" TickFrequency="5"
                                        IsMoveToPointEnabled="True" ValueChanged="OnValignOffsetChanged"/>
                                <Slider x:Name="VoDeepBtm" Grid.Row="3" Grid.Column="3" Tag="deep|bottom" Margin="3,0" VerticalAlignment="Bottom"
                                        Minimum="-40" Maximum="40" Value="0" LargeChange="5" SmallChange="1" TickFrequency="5"
                                        IsMoveToPointEnabled="True" ValueChanged="OnValignOffsetChanged"/>
                            </Grid>
                            <Button x:Name="BtnValignConfirm" Content="确定（固化到代码）" Margin="2,8,0,0" Padding="8,4"
                                    Style="{StaticResource ToolBarBtn}" Click="OnValignOffsetConfirm"
                                    ToolTip="把当前 9 个偏移值写入 index.html 作为默认值，并清除 localStorage 缓存"/>
                        </StackPanel>
                        <Border Height="1" Background="#FF2A2A30" Margin="4,14,0,0"/>

                        <!-- 节点样式：单独给选中节点设置填充/圆角（与自定义主题完全脱钩） -->
                        <Grid Margin="4,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="节点" Style="{StaticResource SegmentTitleBig}" VerticalAlignment="Top"/>
                            <Button Grid.Column="1" Content="清除样式" Style="{StaticResource GhostTextBtn}"
                                    Click="OnClearScopeClick" Tag="node" ToolTip="清除选中节点的填充/圆角"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="填充色" Foreground="#AEB6C4" FontSize="12" VerticalAlignment="Center"/>
                            <Button x:Name="NodeFillBtn" Grid.Column="1" Style="{StaticResource ToolBarBtn}" Padding="10,6"
                                    HorizontalAlignment="Left" Click="OnNodeFillClick" ToolTip="选择选中节点的填充色">
                                <Border x:Name="FillSwatch" Width="18" Height="18" CornerRadius="{StaticResource NeuRadius3}" Background="#000000"/>
                            </Button>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="圆角" Foreground="#AEB6C4" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="RadiusBox" Width="52" Height="28" FontSize="12" TextAlignment="Center"
                                         VerticalContentAlignment="Center" Text="0" Background="#26262B" Foreground="#D9D9D9"
                                         BorderBrush="#383840" CaretBrush="#7FC2FF" InputMethod.IsInputMethodEnabled="False"
                                         PreviewTextInput="OnIntPreviewInput" KeyDown="OnIntKeyDown"
                                         PreviewMouseWheel="OnIntMouseWheel"
                                         LostFocus="OnRadiusLostFocus" ToolTip="圆角半径（0-50，滚轮±1）"/>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="#FF2A2A30" Margin="4,14,0,0"/>

                        <!-- 边框：单独给选中节点设置边框颜色/粗细（与自定义主题完全脱钩） -->
                        <Grid Margin="4,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="边框" Style="{StaticResource SegmentTitleBig}" VerticalAlignment="Top"/>
                            <Button Grid.Column="1" Content="清除样式" Style="{StaticResource GhostTextBtn}"
                                    Click="OnClearScopeClick" Tag="border" ToolTip="清除选中节点的边框样式"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="边框色" Foreground="#AEB6C4" FontSize="12" VerticalAlignment="Center"/>
                            <Button x:Name="NodeStrokeBtn" Grid.Column="1" Style="{StaticResource ToolBarBtn}" Padding="10,6"
                                    Click="OnNodeStrokeClick" ToolTip="选择选中节点的边框颜色">
                                <Border x:Name="StrokeSwatch" Width="18" Height="18" CornerRadius="{StaticResource NeuRadius3}" Background="#000000"/>
                            </Button>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="粗细" Foreground="#AEB6C4" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="StrokeWidthBox" Width="52" Height="28" FontSize="12" TextAlignment="Center"
                                         VerticalContentAlignment="Center" Text="1" Background="#26262B" Foreground="#D9D9D9"
                                         BorderBrush="#383840" CaretBrush="#7FC2FF" InputMethod.IsInputMethodEnabled="False"
                                         PreviewTextInput="OnIntPreviewInput" KeyDown="OnIntKeyDown"
                                         PreviewMouseWheel="OnIntMouseWheel"
                                         LostFocus="OnStrokeWidthLostFocus" ToolTip="边框粗细（0-20，滚轮±1）"/>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="#FF2A2A30" Margin="4,14,0,0"/>

                        <!-- 连线：单独给选中节点设置连线颜色/粗细（与自定义主题完全脱钩） -->
                        <Grid Margin="4,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="连线" Style="{StaticResource SegmentTitleBig}" VerticalAlignment="Top"/>
                            <Button Grid.Column="1" x:Name="ClearLineBtn" Content="清除样式" Style="{StaticResource GhostTextBtn}"
                                    Click="OnClearScopeClick" Tag="line" ToolTip="清除选中节点的连线样式"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="连线色" Foreground="#AEB6C4" FontSize="12" VerticalAlignment="Center"/>
                            <Button x:Name="NodeLineBtn" Grid.Column="1" Style="{StaticResource ToolBarBtn}" Padding="10,6"
                                    Click="OnNodeLineClick" ToolTip="选择选中节点连线的颜色">
                                <Border x:Name="LineSwatch" Width="18" Height="18" CornerRadius="{StaticResource NeuRadius3}" Background="#000000"/>
                            </Button>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="粗细" Foreground="#AEB6C4" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="LineWidthBox" Width="52" Height="28" FontSize="12" TextAlignment="Center"
                                         VerticalContentAlignment="Center" Text="1" Background="#26262B" Foreground="#D9D9D9"
                                         BorderBrush="#383840" CaretBrush="#7FC2FF" InputMethod.IsInputMethodEnabled="False"
                                         PreviewTextInput="OnIntPreviewInput" KeyDown="OnIntKeyDown"
                                         PreviewMouseWheel="OnIntMouseWheel"
                                         LostFocus="OnLineWidthLostFocus" ToolTip="连线粗细（0-20，滚轮±1）"/>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="#FF2A2A30" Margin="4,14,0,0"/>

                        <!-- 外观分组（移至最后）：仅保留整理布局 -->
                        <TextBlock Text="外观" Style="{StaticResource SegmentTitleBig}" Margin="4,16,0,20"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="整理布局" Style="{StaticResource ToolBarBtn}" Padding="12,5"
                                    Click="OnAppearanceClick" Tag="resetlayout"
                                    ToolTip="重新排列节点布局（对齐编辑器【整理布局】）"/>
                            <Button Content="清除全部样式" Style="{StaticResource ToolBarBtn}" Padding="12,5"
                                    Click="OnClearAllStyleClick" ToolTip="清除选中节点的全部节点级样式"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="复制样式" Style="{StaticResource ToolBarBtn}" Padding="12,5"
                                    Click="OnCopyStyleClick" ToolTip="复制选中节点的全部节点级样式"/>
                            <Button Content="粘贴样式" Style="{StaticResource ToolBarBtn}" Padding="12,5"
                                    Click="OnPasteStyleClick" ToolTip="将复制的样式应用到选中节点"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- 文件页签：节点文件附件信息 + 视频播放窗口 + 视频信息列表（附件只存路径，点击图标自动切到此页签） -->
                    <StackPanel x:Name="SidePageFile" Visibility="Collapsed">
                        <TextBlock Text="文件" Style="{StaticResource SegmentTitleBig}" Margin="4,16,0,10"/>
                        <WrapPanel Margin="2,0,0,12">
                            <Button Style="{StaticResource ToolBarBtn}" Content="附加文件..." Padding="12,6" Margin="0,0,8,8"
                                    Click="OnFileAttachClick" ToolTip="为选中节点选择要附加的文件（支持视频）"/>
                            <Button Style="{StaticResource ToolBarBtn}" Content="附加视频..." Padding="12,6" Margin="0,0,8,8"
                                    Click="OnVideoClick" ToolTip="为选中节点选择要附加的视频"/>
                            <Button Style="{StaticResource ToolBarBtn}" Content="移除附件" Padding="12,6" Margin="0,0,8,8"
                                    Click="OnFileRemoveClick" ToolTip="移除选中节点的文件/视频附件"/>
                            <Button Style="{StaticResource ToolBarBtn}" Content="打开" Padding="12,6" Margin="0,0,8,8"
                                    Click="OnFileOpenClick" ToolTip="用系统默认程序打开该文件"/>
                            <Button Style="{StaticResource ToolBarBtn}" Content="定位" Padding="12,6"
                                    Click="OnFileRevealClick" ToolTip="在资源管理器中选中该文件"/>
                        </WrapPanel>
                        <Border Background="#FF1B1B1F" CornerRadius="{StaticResource NeuRadius6}" Padding="10,8"
                                BorderBrush="#FF2A2A30" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="FileNameText" Text="当前节点未附加文件" Foreground="#D9D9D9"
                                           FontSize="12" TextWrapping="Wrap"/>
                                <StackPanel x:Name="FileInfoHost" Margin="0,8,0,0" Focusable="False"/>
                            </StackPanel>
                        </Border>

                        <Border Height="1" Background="#FF2A2A30" Margin="4,16,0,0"/>
                        <TextBlock Text="视频" Style="{StaticResource SegmentTitleBig}" Margin="4,14,0,10"/>
                        <Border Background="#FF000000" CornerRadius="{StaticResource NeuRadius6}" BorderBrush="#FF2A2A30" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <MediaElement x:Name="VideoPlayer" Height="150" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                              ScrubbingEnabled="True" Stretch="Uniform"
                                              MediaOpened="OnVideoMediaOpened" MediaEnded="OnVideoMediaEnded" MediaFailed="OnVideoMediaFailed"/>
                                <TextBlock x:Name="VideoTipText" Text="选择或点击带视频附件的节点后，可在此播放"
                                           Foreground="#7A8090" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                        <Grid Margin="2,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="VideoPlayBtn" Style="{StaticResource ToolBarBtn}" Content="播放" Padding="10,5"
                                    Click="OnVideoPlayPauseClick" ToolTip="播放 / 暂停"/>
                            <Button Grid.Column="1" Style="{StaticResource ToolBarBtn}" Content="停止" Padding="10,5" Margin="6,0,0,0"
                                    Click="OnVideoStopClick" ToolTip="停止播放并回到开头"/>
                            <Slider x:Name="VideoSeek" Grid.Column="2" Margin="10,0,0,0" Minimum="0" Maximum="100"
                                    IsMoveToPointEnabled="True" VerticalAlignment="Center" ToolTip="拖动或点击调整播放进度"/>
                            <TextBlock x:Name="VideoTimeText" Grid.Column="3" Text="0:00" Foreground="#AEB6C4" FontSize="11"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                        <Grid Margin="2,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="音量" Foreground="#AEB6C4" FontSize="12" VerticalAlignment="Center"/>
                            <Slider x:Name="VideoVolume" Grid.Column="1" Margin="8,0,0,0" Minimum="0" Maximum="1" Value="0.8"
                                    IsMoveToPointEnabled="True" VerticalAlignment="Center" ToolTip="播放音量"/>
                        </Grid>
                        <StackPanel x:Name="VideoInfoHost" Margin="4,12,0,0" Focusable="False"/>
                    </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 画布切换条：底部画布标签（参考 XMind）——单击切换、双击重命名、右键重命名/复制/删除，
             按住标签左右拖动重排（AnimatedStackPanel 横向让位动画 + 死区防抖 + 贴边自动滚动），右侧 ＋ 新建 -->
        <Border Grid.Row="2" Margin="0,8,0,0" Background="#FF101318" CornerRadius="{StaticResource NeuRadius6}"
                BorderThickness="1" BorderBrush="#FF2A2A30" Padding="6,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer x:Name="sheetTabsScroll" Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              VerticalAlignment="Center">
                    <ItemsControl x:Name="sheetTabs" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><app:AnimatedStackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:SheetTabItem}">
                                <Button Style="{StaticResource SheetTabBtn}" Margin="0,0,4,0"
                                        Tag="SheetTab" Click="OnSheetTabClick" MouseDoubleClick="OnSheetTabDoubleClick"
                                        ToolTip="{Binding Title}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="重命名" Click="OnSheetRenameClick"/>
                                            <MenuItem Header="复制画布" Click="OnSheetDuplicateClick"/>
                                            <Separator/>
                                            <MenuItem Header="删除画布" Click="OnSheetDeleteClick"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <TextBlock Text="{Binding Title}" MaxWidth="130" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Button Grid.Column="1" Content="＋" Style="{StaticResource ToolBarBtn}" Width="30" Height="26"
                        Padding="0" Margin="6,0,0,0" Click="OnAddSheetClick" ToolTip="新建画布"/>
                <!-- 拖拽插入指示层：覆盖整个标签条（含加号按钮区），命中测试关闭，仅画插入竖条 -->
                <Canvas x:Name="sheetTabOverlay" Grid.ColumnSpan="2" IsHitTestVisible="False" IsEnabled="False"/>
            </Grid>
        </Border>

        <!-- 底部状态条：操作/编辑器状态反馈（标题行删除后迁移至此） -->
        <Border Grid.Row="3" Margin="0,8,0,0" Background="#FF101318" CornerRadius="{StaticResource NeuRadius6}"
                BorderThickness="1" BorderBrush="#FF2A2A30" Padding="10,5">
            <TextBlock x:Name="Status" Style="{StaticResource SectionDesc}" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>