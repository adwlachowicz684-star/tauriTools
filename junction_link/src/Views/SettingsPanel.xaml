<UserControl x:Class="FenPeiXiangMuZu.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:app="clr-namespace:FenPeiXiangMuZu"
             xmlns:conv="clr-namespace:FenPeiXiangMuZu.Converters"
             mc:Ignorable="d"
             d:DesignWidth="1100" d:DesignHeight="640"
             PreviewKeyDown="OnPreviewKeyDown">
    <UserControl.Resources>
        <!-- 内联编辑显隐转换器（图标分组标题双击重命名用，与主窗口集群一致） -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- 最大化贴边修正滑块在「隐藏任务栏」勾选时禁用（取反） -->
        <conv:InverseBoolConverter x:Key="InverseBool"/>
        <!-- 深色滑块（最大/还原贴边修正用；轨道细条 + 圆点滑块，贴合 Neu 风格） -->
        <Style x:Key="NeuSlider" TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource NeuBezelPress}"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="4" CornerRadius="{StaticResource NeuRadius2}" Background="{TemplateBinding Background}" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" IsTabStop="False" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="14" Height="14" CornerRadius="{StaticResource NeuRadius7}"
                                                        Background="{StaticResource NeuSurface}"
                                                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 修正值只读读数（滑块右侧 px） -->
        <Style x:Key="FixReadout" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MainBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Width" Value="30"/>
        </Style>
        <!-- 深色输入框（设置面板局部；供自定义链接名输入，与全局深色风格一致） -->
        <Style x:Key="NeuTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource NeuInset}"/>
            <Setter Property="Foreground" Value="{StaticResource MainBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource NeuBezelPress}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource NeuRadius4}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeuBezelHi}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 深色下拉框（设置面板局部；自动备份间隔选择。精简模板，色彩全部引用全局新拟物资源） -->
        <Style x:Key="NeuComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource MainBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="{StaticResource NeuInset}"
                                                BorderBrush="{StaticResource NeuBezelPress}" BorderThickness="1" CornerRadius="{StaticResource NeuRadius4}">
                                            <Path HorizontalAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center"
                                                  Data="M7,10L12,15L17,10Z" Fill="{StaticResource MutedBrush}" Width="12" Height="12"
                                                  Stretch="Uniform"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeuBezelHi}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="8,0,26,0" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              VerticalAlignment="Center"
                                              TextBlock.Foreground="{StaticResource MainBrush}"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                                   StaysOpen="False" PopupAnimation="Fade">
                                <Border Background="{StaticResource NeuSurfaceLo}"
                                        BorderBrush="{StaticResource NeuBezelHi}" BorderThickness="1"
                                        CornerRadius="{StaticResource NeuRadius4}" Margin="0,2,0,0" MinWidth="{TemplateBinding ActualWidth}">
                                    <ItemsPresenter/>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource MainBrush}"/>
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource NeuSurfaceHi}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource NeuInset}"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 左侧页签按钮样式 ============ -->
        <!-- 选中态：内凹 + 强调色文字 + 左侧强调色竖条；未选中：平面 + 普通文字 + 悬浮高亮 -->
        <Style x:Key="SettingsTabBtn" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="16,0,12,0"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <!-- 左侧选中指示条 -->
                            <Border x:Name="indicator" Width="3" HorizontalAlignment="Left"
                                    Background="Transparent" CornerRadius="0 2 2 0"/>
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    Margin="4,0" CornerRadius="{StaticResource NeuRadius6}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource NeuSurfaceHi}"/>
                                <Setter Property="Foreground" Value="{StaticResource MainBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource NeuInset}"/>
                                <Setter TargetName="indicator" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AcSegRadio" TargetType="RadioButton">
            <!-- 分段单选小药丸：Agent 连锁「项目｜项目组」子切换 -->
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="{StaticResource NeuRadius5}"
                                BorderThickness="1" BorderBrush="Transparent" Padding="12,4">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource NeuSurfaceHi}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource NeuAccentTint}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeuBezelPress}"/>
                                <Setter Property="Foreground" Value="{StaticResource MainBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AcTabPill" TargetType="ListBoxItem">
            <!-- Agent 连锁动作页签药丸：悬停浮起、选中内凹高亮；拖拽换序由代码后台驱动 -->
            <Setter Property="Template">
                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="bd" Background="Transparent" CornerRadius="{StaticResource NeuRadius6}"
                                                                BorderThickness="1" BorderBrush="Transparent"
                                                                Padding="12,5" Margin="0,0,6,0" Cursor="Hand">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock x:Name="ic" Text="{Binding Icon}" Tag="AcIcon"
                                                                           FontFamily="Segoe Fluent Icons" FontSize="12"
                                                                           VerticalAlignment="Center" Margin="0,0,5,0"
                                                                           Foreground="{StaticResource AccentBrush}"
                                                                           ToolTip="点击更换图标"/>
                                                                <TextBlock x:Name="nm" Text="{Binding Name}" FontSize="12"
                                                                           VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                                                                <TextBlock x:Name="sc" Text="{Binding ShortcutDisplay}" FontSize="10"
                                                                           VerticalAlignment="Center" Margin="6,0,0,0"
                                                                           Foreground="{StaticResource MutedBrush}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ShortcutDisplay}" Value="">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource NeuSurfaceHi}"/>
                                                                <Setter TargetName="nm" Property="Foreground" Value="{StaticResource MainBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource NeuAccentTint}"/>
                                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeuBezelPress}"/>
                                                                <Setter TargetName="nm" Property="Foreground" Value="{StaticResource MainBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 单个链接名项模板：置顶/非置顶区共用。图钉未置顶时仅鼠标悬浮显示，置顶后常驻高亮；双击可编辑备注。 -->
        <DataTemplate x:Key="LinkAgentItemTemplate">
            <Border Margin="0,3" Padding="8,3" Background="Transparent"
                    MouseEnter="OnItemMouseEnter" MouseLeave="OnItemMouseLeave"
                    ToolTip="复选框单击即时切换；名称单击切换、双击编辑（名称/厂商/备注/置顶/前置点）">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- 复选框：单击即时切换勾选（独立于名称，双击不弹编辑窗） -->
                    <CheckBox Style="{StaticResource CheckLabel}" Margin="0,0,0,0"
                              IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              VerticalAlignment="Center"/>
                    <!-- 名称区域：双击打开编辑弹窗，单击不切换勾选 -->
                    <StackPanel Grid.Column="1" Margin="8,0,0,0" Cursor="Hand"
                                PreviewMouseLeftButtonDown="OnItemNamePreviewMouseLeftDown">
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitleMono}"/>
                            <TextBlock Text="{Binding Vendor}" Style="{StaticResource Caption}"
                                       Margin="8,0,0,0"/>
                        </StackPanel>
                        <!-- 备注行：仅自定义项带备注时显示 -->
                        <TextBlock Text="{Binding Remark}" Foreground="{DynamicResource MutedBrush}"
                                   FontSize="11" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Remark}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasRemark}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 置顶按钮：未置顶时仅悬浮显示；已置顶常驻并高亮。
                             默认 Hidden（占位但不可见）而非 Collapsed：悬浮显隐不改变布局，
                             避免 UniformGrid 列宽随鼠标悬浮变化引发该项位移、来回触发 Enter/Leave 抖动。 -->
                        <Button Width="22" Height="22" FontSize="11" Content="&#xE718;"
                                Command="{Binding TogglePinCommand}" ToolTip="置顶 / 取消置顶">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconBtn}">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsHovered}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <!-- 删除按钮：仅自定义项可见 -->
                        <Button Width="22" Height="22" FontSize="11" Margin="6,0,0,0"
                                VerticalAlignment="Center" ToolTip="删除此自定义链接名"
                                Content="&#xE74D;" Command="{Binding RemoveCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconBtnDanger}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCustom}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 预设图标项模板：缩略图 + 名称 + 悬停删除按钮；双击重命名、单击删除。 -->
        <DataTemplate x:Key="PresetIconItemTemplate">
            <Border Margin="0,3" Padding="8,4" Background="Transparent"
                    MouseEnter="OnPresetItemMouseEnter" MouseLeave="OnPresetItemMouseLeave"
                    PreviewMouseLeftButtonDown="OnPresetItemPreviewLeftDown"
                    ToolTip="双击重命名；悬浮右侧可删除">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="26" Height="26" Background="{StaticResource NeuSurfaceHi}"
                                CornerRadius="{StaticResource NeuRadius4}" VerticalAlignment="Center">
                            <Image Source="{Binding Icon}" Width="20" Height="20"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock Text="{Binding Name}" Margin="6,0,0,0"
                                   FontSize="12" Foreground="{StaticResource MainBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="1" Width="22" Height="22" FontSize="11"
                            Margin="4,0,0,0" VerticalAlignment="Center"
                            Content="&#xE74D;" ToolTip="删除此预设图标" Click="OnPresetDeleteClick">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconBtnDanger}">
                                <!-- 预设图标项位于 UniformGrid 多列网格，悬浮删除按钮必须 Hidden 占位，
                                     避免 Collapsed→Visible 撑大列宽引发该项位移与悬浮抖动（美术标准「九」）。 -->
                                <Setter Property="Visibility" Value="Hidden"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHovered}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 图标分组模板：分组标题（双击重命名、拖拽排序）+ 可折叠的图标网格 -->
        <DataTemplate x:Key="IconGroupTemplate">
            <Border Margin="0,0,0,6"
                    Background="{StaticResource NeuSurfaceLo}"
                    BorderBrush="{StaticResource NeuBezel}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource NeuRadius6}"
                    Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 分组标题栏：空白处单击立即折叠（零延迟）、文字单击延迟折叠（区分双击重命名）；
                         按住拖动 = 集群式悬浮重排（实时让位+自动滚动）。
                         用隧道事件 PreviewMouseLeftButtonDown：保证文字/空白区都能命中。 -->
                    <Border Grid.Row="0" CornerRadius="6,6,0,0" Padding="8,4"
                            Background="Transparent"
                            Tag="IconGroupHeader"
                            MouseEnter="OnIconGroupMouseEnter"
                            MouseLeave="OnIconGroupMouseLeave"
                            PreviewMouseLeftButtonDown="OnIconGroupHeaderDown"
                            MouseLeftButtonUp="OnIconGroupHeaderUp">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Tag="IconGroupHeaderText" Orientation="Horizontal" VerticalAlignment="Center"
                                        MouseLeftButtonDown="OnIconGroupTextDown">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                           FontSize="12" Foreground="{StaticResource MainBrush}"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- 内联重命名输入框：双击标题进入编辑时显示并聚焦；Enter 提交、Esc 取消、失焦提交 -->
                                <TextBox Text="{Binding Name, Mode=OneWay}"
                                         Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                         KeyDown="OnIconGroupNameKeyDown" LostFocus="OnIconGroupNameLostFocus"
                                         Foreground="{StaticResource MainBrush}" CaretBrush="{StaticResource AccentBrush}"
                                         BorderThickness="0" Background="Transparent" Padding="0" Margin="0"
                                         VerticalAlignment="Center" MinWidth="40" FontSize="12"/>
                                <TextBlock Text="{Binding Count}" Margin="6,0,0,0"
                                           FontSize="11" Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- 折叠/展开按钮：箭头随状态旋转（展开=向上，折叠=向下），位置固定 -->
                                <Button Style="{StaticResource BoxActionBtn}" Width="20" Height="20" Margin="0"
                                        Padding="0" ToolTip="折叠/展开该组"
                                        Click="OnToggleIconGroupCollapse">
                                    <Path Width="10" Height="10" Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M7.41,15.41L12,10.83L16.59,15.41L18,14L12,8L6,14L7.41,15.41Z">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="0" CenterX="5" CenterY="5"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="180" CenterX="5" CenterY="5"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Button>
                                <!-- 删除按钮：仅悬浮标题栏时显示，避免常驻误点；隐藏时仍占位保持布局稳定 -->
                                <Button Width="20" Height="20" FontSize="11" Margin="6,0,0,0"
                                        Padding="0" ToolTip="删除该分组"
                                        Click="OnIconGroupDeleteClick"
                                        Content="&#xE74D;">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource IconBtnDanger}">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHovered}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 分组内容：图标网格（图标文件可拖入本组；拖放统一由 iconGroupList 处理） -->
                    <Border Grid.Row="1" CornerRadius="0,0,6,6" Padding="6,4"
                            Tag="IconGroupDropArea">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ItemsControl ItemsSource="{Binding Items}"
                                      ItemTemplate="{StaticResource PresetIconItemTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- 根元素不再套 Card：外层浮层 settingsPopup 已是 Card 底板，避免两层嵌套底板 -->
    <Border Padding="6,4">
        <Grid Margin="10,8">
            <Grid.RowDefinitions>
                <!-- 顶部标题栏 -->
                <RowDefinition Height="Auto"/>
                <!-- 主体：左侧页签 + 右侧内容 -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============ 顶部标题栏 ============ -->
            <Grid Margin="6,4,6,8">
                <TextBlock Text="设置" Style="{StaticResource PanelTitle}"/>
                <Button Content="&#xE894;" Style="{StaticResource IconBtn}"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        ToolTip="关闭" Click="OnCloseClick"/>
            </Grid>

            <!-- ============ 主体：左页签栏 + 右内容区 ============ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- 左侧页签导航（固定宽度） -->
                    <ColumnDefinition Width="130"/>
                    <!-- 分隔线 -->
                    <ColumnDefinition Width="1"/>
                    <!-- 右侧内容区 -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧页签栏 -->
                <Border Background="{StaticResource NeuSurfaceLo}" CornerRadius="{StaticResource NeuRadius6}" Padding="0,4">
                    <StackPanel>
                        <RadioButton Content="基础设置" Style="{StaticResource SettingsTabBtn}"
                                     IsChecked="True" GroupName="SettingsTabs"
                                     Checked="OnTabChecked" Tag="Basic"/>
                        <RadioButton Content="目录设置" Style="{StaticResource SettingsTabBtn}"
                                     GroupName="SettingsTabs"
                                     Checked="OnTabChecked" Tag="Dirs"/>
                        <RadioButton Content="链接" Style="{StaticResource SettingsTabBtn}"
                                     GroupName="SettingsTabs"
                                     Checked="OnTabChecked" Tag="Links"/>
                        <RadioButton Content="图标" Style="{StaticResource SettingsTabBtn}"
                                     GroupName="SettingsTabs"
                                     Checked="OnTabChecked" Tag="Icons"/>
                        <RadioButton Content="快捷键" Style="{StaticResource SettingsTabBtn}"
                                     GroupName="SettingsTabs"
                                     Checked="OnTabChecked" Tag="Shortcuts"/>
                        <RadioButton Content="Agent 连锁" Style="{StaticResource SettingsTabBtn}"
                                     GroupName="SettingsTabs"
                                     Checked="OnTabChecked" Tag="AgentChain"/>
                        <RadioButton Content="脑图" Style="{StaticResource SettingsTabBtn}"
                                     GroupName="SettingsTabs"
                                     Checked="OnTabChecked" Tag="MindMap"/>
                        <CheckBox x:Name="devModeCheck" Content="开发者模式" Margin="16,14,8,4" FontSize="11"
                                  Foreground="{StaticResource MutedBrush}" Cursor="Hand"
                                  IsChecked="{Binding DevMode, Mode=TwoWay}"
                                  ToolTip="开启后允许删除/重命名内置连锁动作页签（审查/归并/部署）"/>
                    </StackPanel>
                </Border>

                <!-- 分隔线 -->
                <Border Grid.Column="1" Background="{StaticResource NeuBezelPress}" Margin="4,0"/>

                <!-- 右侧内容区：整体滚动兜底（面板高度不足时出纵向滚动条，各页签内容不再超框） -->
                <Grid x:Name="settingsHost" Grid.Column="2" ClipToBounds="True"
                      Margin="10,0,4,0"
                      SizeChanged="OnSettingsScrollSizeChanged">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <!-- ========== 页签内容：基础设置 ========== -->
                        <StackPanel x:Name="TabBasic">
                            <Grid Margin="0,2,0,6">
                                <TextBlock Text="基础设置" Style="{StaticResource SectionTitle}"/>
                            </Grid>

                            <Border Background="{StaticResource NeuInset}" BorderBrush="{StaticResource NeuBezelPress}"
                                    BorderThickness="1" CornerRadius="{StaticResource NeuRadius6}" Padding="14,12">
                                <StackPanel>
                                    <CheckBox Content="拖入的文件夹默认选中"
                                              IsChecked="{Binding AutoSelect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource CheckLabel}" Margin="0,4"
                                              ToolTip="拖拽分配时，默认选中目标文件夹中的内容"/>
                                    <CheckBox Content="快速链接（拖项目组⇄项目时直接创建链接）"
                                              IsChecked="{Binding QuickLink, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource CheckLabel}" Margin="0,10,0,4"
                                              ToolTip="拖拽项目组⇄项目时直接创建链接而非复制"/>
                                    <CheckBox Content="在面板按钮上显示快捷键"
                                              IsChecked="{Binding ShowShortcuts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource CheckLabel}" Margin="0,10,0,4"
                                              ToolTip="勾选后在侧边栏操作按钮及顶栏 TIPS / MCP / 设置 / 托盘按钮上显示对应快捷键（自定义配置后同步更新）"/>
                                    <CheckBox Content="展开侧边栏常驻"
                                              IsChecked="{Binding SidebarPersistent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource CheckLabel}" Margin="0,10,0,4"
                                              ToolTip="名称浮层展示形式：勾选后由顶部切换按钮控制名称浮层常驻显隐（再点收起）；取消（默认）则鼠标悬停到侧边栏图标时临时浮出对应区域名称。两种形式下侧边栏图标条都保持窄宽不变、主区不被挤压。"/>
                                    <CheckBox Content="全屏时隐藏 Windows 任务栏"
                                              IsChecked="{Binding HideTaskbarInFullscreen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource CheckLabel}" Margin="0,10,0,4"
                                              ToolTip="勾选后最大化/全屏时窗口铺满整个屏幕并把 Windows 任务栏盖住；取消后仅在其上方的工作区内最大化、任务栏保持可见"/>
                                    <CheckBox Content="关闭软件时隐藏到托盘"
                                              IsChecked="{Binding HideToTrayOnClose, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource CheckLabel}" Margin="0,10,0,4"
                                              ToolTip="勾选后点标题栏关闭按钮或按 Alt+F4 时，不退出而是最小化到系统托盘（双击托盘图标恢复；托盘右键菜单可「退出」）；取消则直接退出。此勾选不影响点「隐藏到托盘」按钮的行为"/>
                                    <CheckBox Content="退出时关闭 MCP 后台进程"
                                              IsChecked="{Binding CloseMcpOnExit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource CheckLabel}" Margin="0,10,0,4"
                                              ToolTip="勾选后，真正退出本软件（含托盘菜单「退出」）时同时结束由 AI 客户端（如 TRAE）启动的 MCP 后台进程，避免残留后台进程；取消则退出后保留 MCP 继续为 AI 提供工具服务。隐藏到托盘不触发"/>
                                    <CheckBox Content="跨项目/项目组移动时同步移动文件夹"
                                              IsChecked="{Binding MoveFolderOnCrossMove, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource CheckLabel}" Margin="0,10,0,4"
                                              ToolTip="勾选后，把卡片在项目区与项目组区之间来回拖动时，同时把该文件夹物理搬到对应的根目录（项目→「新建项目组父目录」、项目组→「新建项目父目录」），并同步更新链接记录与全部路径引用；取消则仅移动卡片、文件夹保持原位"/>
                                    <Grid Margin="0,10,0,4" IsEnabled="{Binding MoveFolderOnCrossMove}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="搬家范围" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                                        <ComboBox Grid.Column="1" Style="{StaticResource NeuComboBox}" HorizontalAlignment="Left"
                                                  MinWidth="230" MaxWidth="320"
                                                  SelectedValuePath="Tag"
                                                  SelectedValue="{Binding MoveFolderScope, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="跨类别移动卡片时物理搬家的范围：&#10;· 默认根目录下（含嵌套）：卡片位于项目/项目组默认根目录下即搬，根内的嵌套层级路径（如 项目组\游戏开发\合成打蛇）也扁平化搬到目标根；&#10;· 仅默认根目录下：仅默认根下的卡片搬，已在目标根内嵌套的保持原位；&#10;· 任意位置：不管卡片在哪都搬。&#10;未开启「跨项目/项目组移动时同步移动文件夹」时此设置不生效。">
                                            <ComboBoxItem Content="默认根目录下（含嵌套层级）" Tag="defaultRootsFlatten"/>
                                            <ComboBoxItem Content="仅默认根目录下" Tag="defaultRoots"/>
                                            <ComboBoxItem Content="任意位置" Tag="anywhere"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="基础设置控制分配与建链的默认行为，改动即时保存。"
                                       Style="{StaticResource Caption}" Margin="0,8,0,4"/>

                            <!-- ===== 预览区「打开编辑」：程序选择（跟随系统 / 搜索 / 浏览手动添加） ===== -->
                            <Grid Margin="0,10,0,6">
                                <TextBlock Text="预览区打开编辑" Style="{StaticResource SectionTitle}"/>
                            </Grid>
                            <Border Background="{StaticResource NeuInset}" BorderBrush="{StaticResource NeuBezelPress}"
                                    BorderThickness="1" CornerRadius="{StaticResource NeuRadius6}" Padding="14,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="打开方式（点击选用）" Style="{StaticResource FieldLabel}"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="搜索" Style="{StaticResource MiniGhost}" Padding="12,4"
                                                Margin="8,0,0,0" VerticalAlignment="Center"
                                                Command="{Binding SearchEditorsCommand}"
                                                ToolTip="枚举系统右键「打开方式」中可打开 .md 的程序"/>
                                        <Button Grid.Column="2" Content="浏览…" Style="{StaticResource MiniGhost}" Padding="12,4"
                                                Margin="6,0,0,0" VerticalAlignment="Center"
                                                Click="OnEditToolBrowseClick" ToolTip="列表中没有的程序可在此手动添加（exe）"/>
                                    </Grid>
                                    <!-- 选择区：WrapPanel 平铺 图标+名称；单选即写入上方路径（当前配置项自动预选高亮） -->
                                    <ListBox ItemsSource="{Binding EditorCandidates}"
                                             SelectedItem="{Binding SelectedEditor, Mode=TwoWay}"
                                             Background="Transparent" BorderThickness="0"
                                             MaxHeight="150" Margin="0,6,0,0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="bd" Background="Transparent" CornerRadius="{StaticResource NeuRadius5}"
                                                                    BorderThickness="1" BorderBrush="Transparent"
                                                                    Padding="8,4" Margin="0,0,6,6" Cursor="Hand">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Grid Width="16" Height="16" VerticalAlignment="Center">
                                                                    <Image Source="{Binding Icon}" Width="16" Height="16"/>
                                                                    <!-- 图标缺失兜底：MDL2 字形（跟随系统=齿轮 / 无图标程序=页面） -->
                                                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" FontSize="13"
                                                                               Foreground="{StaticResource MutedBrush}"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Grid>
                                                                <TextBlock Text="{Binding Name}" FontSize="11" Margin="6,0,0,0"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{StaticResource MainBrush}"/>
                                                            </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource NeuSurfaceHi}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource NeuAccentTint}"/>
                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeuBezelPress}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="作用于底部预览区的「打开编辑」按钮：选中列表项用对应程序打开当前预览的源文件；选「跟随系统」由系统按文件关联选择。「浏览…」可手动添加列表中没有的程序。改动即时保存。"
                                       Style="{StaticResource Caption}" Margin="0,8,0,4"/>

                            </StackPanel>

                        <!-- ========== 页签内容：目录设置 ========== -->
                        <StackPanel x:Name="TabDirs" Visibility="Collapsed">
                            <!-- ===== 目录管理：快捷打开 ===== -->
                            <Grid Margin="0,2,0,6">
                                <TextBlock Text="目录管理" Style="{StaticResource SectionTitle}"/>
                            </Grid>
                            <Border Background="{StaticResource NeuInset}" BorderBrush="{StaticResource NeuBezelPress}"
                                    BorderThickness="1" CornerRadius="{StaticResource NeuRadius6}" Padding="14,12">
                                <StackPanel>
                                    <WrapPanel>
                                        <Button Content="打开数据目录" Style="{StaticResource MiniGhost}" Padding="14,5" Margin="0,0,8,8"
                                                Click="OnOpenDataDirClick" ToolTip="在资源管理器中打开存储配置与记录的数据目录"/>
                                        <Button Content="打开项目备份目录" Style="{StaticResource MiniGhost}" Padding="14,5" Margin="0,0,8,8"
                                                Click="OnOpenProjectBackupDirClick" ToolTip="打开解析后的项目备份目标目录（未配置时使用默认路径）"/>
                                        <Button Content="打开项目组备份目录" Style="{StaticResource MiniGhost}" Padding="14,5" Margin="0,0,8,8"
                                                Click="OnOpenGroupBackupDirClick" ToolTip="打开解析后的项目组备份目标目录（未配置时使用默认路径）"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="数据目录存放 config.json、link-record.json 与预设图标库；备份目录未配置时使用默认路径。"
                                       Style="{StaticResource Caption}" Margin="0,8,0,4"/>

                            <!-- ===== 数据目录信息 ===== -->
                            <Grid Margin="0,10,0,6">
                                <TextBlock Text="数据目录" Style="{StaticResource SectionTitle}"/>
                            </Grid>
                            <Border Background="{StaticResource NeuInset}" BorderBrush="{StaticResource NeuBezelPress}"
                                    BorderThickness="1" CornerRadius="{StaticResource NeuRadius6}" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="数据目录（只读）" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding DataDir}" Style="{StaticResource ItemTitleMono}"
                                               TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="config.json（配置）、link-record.json（链接账本）、preseticons（预设图标库）均存放于此；如需迁移，请先关闭本工具再整体移动该目录。"
                                       Style="{StaticResource Caption}" Margin="0,8,0,4"/>

                            <!-- ===== 一键备份：目标目录 / 只增模式 / 自动备份间隔 ===== -->
                            <Grid Margin="0,10,0,6">
                                <TextBlock Text="一键备份" Style="{StaticResource SectionTitle}"/>
                            </Grid>
                            <Border Background="{StaticResource NeuInset}" BorderBrush="{StaticResource NeuBezelPress}"
                                    BorderThickness="1" CornerRadius="{StaticResource NeuRadius6}" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="项目备份目录" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="bpProjBox" Style="{StaticResource NeuTextBox}"
                                                 Text="{Binding BackupProjectDirText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="留空使用默认：exe 所在目录\backkup_项目备份"/>
                                        <TextBlock Text=".\backkup_项目备份" IsHitTestVisible="False" Margin="9,0,0,0"
                                                   VerticalAlignment="Center" FontSize="12" Opacity="0.55"
                                                   Foreground="{StaticResource MutedBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=bpProjBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Grid.Column="1" Content="浏览…" Style="{StaticResource MiniGhost}" Padding="12,4"
                                                Margin="8,0,0,0" VerticalAlignment="Center"
                                                Click="OnBackupProjectBrowseClick" ToolTip="选择项目备份目标文件夹"/>
                                        <Button Grid.Column="2" Content="使用默认" Style="{StaticResource MiniGhost}" Padding="12,4"
                                                Margin="6,0,0,0" VerticalAlignment="Center"
                                                Click="OnBackupProjectResetClick" ToolTip="清空自定义目录，使用默认 exe 所在目录\backkup_项目备份"/>
                                    </Grid>

                                    <TextBlock Text="项目组备份目录" Style="{StaticResource FieldLabel}" Margin="0,10,0,3"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="bpGrpBox" Style="{StaticResource NeuTextBox}"
                                                 Text="{Binding BackupGroupDirText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="留空使用默认：exe 所在目录\backkup_项目组备份"/>
                                        <TextBlock Text=".\backkup_项目组备份" IsHitTestVisible="False" Margin="9,0,0,0"
                                                   VerticalAlignment="Center" FontSize="12" Opacity="0.55"
                                                   Foreground="{StaticResource MutedBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=bpGrpBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Grid.Column="1" Content="浏览…" Style="{StaticResource MiniGhost}" Padding="12,4"
                                                Margin="8,0,0,0" VerticalAlignment="Center"
                                                Click="OnBackupGroupBrowseClick" ToolTip="选择项目组备份目标文件夹"/>
                                        <Button Grid.Column="2" Content="使用默认" Style="{StaticResource MiniGhost}" Padding="12,4"
                                                Margin="6,0,0,0" VerticalAlignment="Center"
                                                Click="OnBackupGroupResetClick" ToolTip="清空自定义目录，使用默认 exe 所在目录\backkup_项目组备份"/>
                                    </Grid>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Content="只增模式（源中删除的文件在备份中保留）"
                                                  IsChecked="{Binding BackupAppendOnly, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource CheckLabel}" VerticalAlignment="Center"
                                                  ToolTip="开启：仅新增和更新文件；关闭：镜像同步，源中已删除的文件也会从备份中清除"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="自动备份" Style="{StaticResource FieldLabel}" Margin="0,0,8,0"
                                                       VerticalAlignment="Center"/>
                                            <ComboBox Style="{StaticResource NeuComboBox}" Width="130"
                                                      SelectedValuePath="Tag"
                                                      SelectedValue="{Binding BackupAutoMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      ToolTip="按此间隔自动执行一次一键备份；关闭则仅手动/指令触发">
                                                <ComboBoxItem Content="关闭" Tag="0"/>
                                                <ComboBoxItem Content="每 15 分钟" Tag="15"/>
                                                <ComboBoxItem Content="每 30 分钟" Tag="30"/>
                                                <ComboBoxItem Content="每 1 小时" Tag="60"/>
                                                <ComboBoxItem Content="每 2 小时" Tag="120"/>
                                                <ComboBoxItem Content="每 6 小时" Tag="360"/>
                                                <ComboBoxItem Content="每 12 小时" Tag="720"/>
                                                <ComboBoxItem Content="每天" Tag="1440"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="备份将各文件夹完整复制到目标目录（按文件大小+修改时间增量比对）；junction/符号链接不深入复制；改动即时保存，也可由 MCP 工具 backup_now 触发。"
                                       Style="{StaticResource Caption}" Margin="0,8,0,4"/>

                            <!-- 分区: 创建预设 -->
                            <Grid Margin="0,10,0,6">
                                <TextBlock Text="创建预设" Style="{StaticResource SectionTitle}"/>
                            </Grid>
                            <Border Background="{StaticResource NeuInset}" BorderBrush="{StaticResource NeuBezelPress}"
                                    BorderThickness="1" CornerRadius="{StaticResource NeuRadius6}" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="项目创建预设文件夹" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="cpProjBox" Style="{StaticResource NeuTextBox}"
                                                 Text="{Binding CreateProjectDirText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="新建项目时的预设父目录；留空则每次新建时弹文件夹选择框"/>
                                        <TextBlock Text="（未配置：每次新建时选择）" IsHitTestVisible="False" Margin="9,0,0,0"
                                                   VerticalAlignment="Center" FontSize="12" Opacity="0.55"
                                                   Foreground="{StaticResource MutedBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=cpProjBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Grid.Column="1" Content="浏览…" Style="{StaticResource MiniGhost}" Padding="12,4"
                                                Margin="8,0,0,0" VerticalAlignment="Center"
                                                Click="OnCreateProjectDirBrowseClick" ToolTip="选择新建项目时的预设父目录"/>
                                        <Button Grid.Column="2" Content="使用默认" Style="{StaticResource MiniGhost}" Padding="12,4"
                                                Margin="6,0,0,0" VerticalAlignment="Center"
                                                Click="OnCreateProjectDirResetClick" ToolTip="清空自定义目录，新建时每次弹文件夹选择框"/>
                                    </Grid>

                                    <TextBlock Text="项目组创建预设文件夹" Style="{StaticResource FieldLabel}" Margin="0,10,0,3"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="cpGrpBox" Style="{StaticResource NeuTextBox}"
                                                 Text="{Binding CreateGroupDirText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="新建项目组时的预设父目录；留空则每次新建时弹文件夹选择框"/>
                                        <TextBlock Text="（未配置：每次新建时选择）" IsHitTestVisible="False" Margin="9,0,0,0"
                                                   VerticalAlignment="Center" FontSize="12" Opacity="0.55"
                                                   Foreground="{StaticResource MutedBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=cpGrpBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Grid.Column="1" Content="浏览…" Style="{StaticResource MiniGhost}" Padding="12,4"
                                                Margin="8,0,0,0" VerticalAlignment="Center"
                                                Click="OnCreateGroupDirBrowseClick" ToolTip="选择新建项目组时的预设父目录"/>
                                        <Button Grid.Column="2" Content="使用默认" Style="{StaticResource MiniGhost}" Padding="12,4"
                                                Margin="6,0,0,0" VerticalAlignment="Center"
                                                Click="OnCreateGroupDirResetClick" ToolTip="清空自定义目录，新建时每次弹文件夹选择框"/>
                                    </Grid>

                                    <TextBlock Text="项目组创建模板文件夹" Style="{StaticResource FieldLabel}" Margin="0,10,0,3"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="cpGrpTplBox" Style="{StaticResource NeuTextBox}"
                                                 Text="{Binding CreateGroupTemplateDirText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="新建项目组时拷贝此模板文件夹的内容；留空使用内置默认模板"/>
                                        <TextBlock Text="E:\_project\AIProject_opencode\_项目模板" IsHitTestVisible="False" Margin="9,0,0,0"
                                                   VerticalAlignment="Center" FontSize="12" Opacity="0.55"
                                                   Foreground="{StaticResource MutedBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=cpGrpTplBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Grid.Column="1" Content="浏览…" Style="{StaticResource MiniGhost}" Padding="12,4"
                                                Margin="8,0,0,0" VerticalAlignment="Center"
                                                Click="OnCreateGroupTemplateBrowseClick" ToolTip="选择新建项目组时拷贝的模板文件夹"/>
                                        <Button Grid.Column="2" Content="使用默认" Style="{StaticResource MiniGhost}" Padding="12,4"
                                                Margin="6,0,0,0" VerticalAlignment="Center"
                                                Click="OnCreateGroupTemplateResetClick" ToolTip="恢复内置默认模板：E:\_project\AIProject_opencode\_项目模板"/>
                                    </Grid>

                                    <CheckBox Content="新建项目/项目组时路径携带页签及集群层级"
                                              IsChecked="{Binding CreatePathCarriesHierarchy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource CheckLabel}" Margin="0,10,0,0"
                                              ToolTip="勾选后：新建项目存放为「父目录\当前项目页签名\项目名」，新建项目组存放为「父目录\当前项目组集群名\项目组名」；取消则直接存放在父目录下"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="新建项目/新建项目组按钮位于主窗口「项目」「项目组」面板标题栏右侧；新建项目组时自动拷贝模板文件夹内容，未配置预设目录时每次新建会弹文件夹选择框。"
                                       Style="{StaticResource Caption}" Margin="0,8,0,4"/>
                        </StackPanel>

                        <!-- ========== 页签内容：链接 ========== -->
                        <StackPanel x:Name="TabLinks" Visibility="Collapsed">
                            <!-- Agent 链接名标题 + 全选/全不选 -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                    <TextBlock Text="链接名称" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Margin="8,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center">
                                        <Run Text="『可批量生成，" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                        <Run Text="{Binding LinkSettings.EnabledCount, Mode=OneWay}" Foreground="#FFB4B9C2" FontSize="12"/>
                                        <Run Text="/" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                        <Run Text="{Binding LinkSettings.Total, Mode=OneWay}" Foreground="#FFB4B9C2" FontSize="12"/>
                                        <Run Text="个链接目录名称批量已开启』" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" Content="全选" Style="{StaticResource MiniGhost}"
                                        Command="{Binding LinkSettings.SelectAllCommand}" Margin="0,0,6,0" Padding="14,5" FontSize="12"/>
                                <Button Grid.Column="2" Content="全不选" Style="{StaticResource MiniGhost}"
                                        Command="{Binding LinkSettings.SelectNoneCommand}" Padding="14,5" FontSize="12"/>
                            </Grid>

                            <!-- UniformGrid 2 列列表：置顶区 / 分隔线 / 非置顶区 -->
                            <Border Background="{StaticResource NeuInset}" BorderBrush="{StaticResource NeuBezelPress}"
                                    BorderThickness="1" CornerRadius="{StaticResource NeuRadius6}" Padding="10,6">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding LinkSettings.PinnedItems}"
                                                  ItemTemplate="{StaticResource LinkAgentItemTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <!-- 分隔线：存在置顶项时显示 -->
                                    <Border Height="1" Background="{StaticResource NeuBezelHi}" Margin="4,6">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LinkSettings.HasPinned}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding LinkSettings.NormalItems}"
                                                  ItemTemplate="{StaticResource LinkAgentItemTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- 自定义链接名添加行：名称 + 厂商 + 备注 + 前置点 + 直接置顶 + 添加 -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="链接名" Style="{StaticResource FieldLabel}"
                                               Margin="0,0,0,3"/>
                                    <TextBox Style="{StaticResource NeuTextBox}"
                                             Text="{Binding LinkSettings.InputName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="输入自定义链接名，如 foo 或 .myagent（勾选前置点则自动补 '.'）"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="厂商" Style="{StaticResource FieldLabel}"
                                               Margin="0,0,0,3"/>
                                    <TextBox Style="{StaticResource NeuTextBox}"
                                             Text="{Binding LinkSettings.InputVendor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="厂商/标注（可选）：显示在链接名旁，如 OpenCode；留空则显示「自定义」"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                    <TextBlock Text="备注（可选）" Style="{StaticResource FieldLabel}"
                                               Margin="0,0,0,3"/>
                                    <TextBox Style="{StaticResource NeuTextBox}"
                                             Text="{Binding LinkSettings.InputRemark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="备注（可选）：说明该链接名的用途，随项显示"/>
                                </StackPanel>
                                <CheckBox Grid.Column="3" Content="前置点" Style="{StaticResource CheckLabel}"
                                          IsChecked="{Binding LinkSettings.DotOnAdd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          VerticalAlignment="Center" Margin="12,0,0,0" ToolTip="名称前自动加 '.'（如 foo → .foo）"/>
                                <CheckBox Grid.Column="4" Content="置顶" Style="{StaticResource CheckLabel}"
                                          IsChecked="{Binding LinkSettings.PinOnAdd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          VerticalAlignment="Center" Margin="12,0,0,0" ToolTip="添加后直接置顶到列表顶部"/>
                                <Button Grid.Column="5" Content="添加" Style="{StaticResource MiniAccent}"
                                        Command="{Binding LinkSettings.AddCustomCommand}"
                                        Margin="10,0,0,0" Padding="16,5" FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding LinkSettings.AddError}"
                                       Foreground="#E5484D" FontSize="11" TextWrapping="Wrap" Margin="2,4,0,0"/>

                            <TextBlock Text="勾选项在拖拽建链（或 MCP 建链）时，为项目在该目录名下创建指向项目组根的 junction；图钉可置顶排序，预设名单不可删，自定义项可添加/删除；改动即时保存。"
                                       Style="{StaticResource Caption}" Margin="0,8,0,4"/>
                        </StackPanel>

                        <!-- ========== 页签内容：图标 ========== -->
                        <StackPanel x:Name="TabIcons" Visibility="Collapsed">
                            <!-- ===== 软件图标：替换软件自身图标（拖入 / 粘贴 / 浏览），重启生效 ===== -->
                            <Grid Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="软件图标" Style="{StaticResource SectionTitle}"/>
                                </StackPanel>
                            </Grid>
                            <Border Background="{StaticResource NeuInset}" BorderBrush="{StaticResource NeuBezelPress}"
                                    BorderThickness="1" CornerRadius="{StaticResource NeuRadius6}" Padding="14,12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="64" Height="64" CornerRadius="{StaticResource NeuRadius8}" VerticalAlignment="Center"
                                                Background="{StaticResource NeuInset}"
                                                BorderBrush="{StaticResource NeuBezelPress}" BorderThickness="1"
                                                Padding="6">
                                            <Image x:Name="appIconPreview"
                                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="替换软件自身的图标（窗口标题栏 / 任务栏 / 托盘）"
                                                       Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Border x:Name="appIconDropZone" AllowDrop="True"
                                                        DragOver="OnAppIconDropZoneDragOver" Drop="OnAppIconDropZoneDrop"
                                                        Background="{StaticResource NeuInset}"
                                                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                                        CornerRadius="{StaticResource NeuRadius6}" Padding="14,8"
                                                        ToolTip="把 ico/png/jpg 等图片文件拖到这里即可预览设为软件图标">
                                                    <TextBlock Text="拖入图片 / 图标文件" FontSize="12" Opacity="0.8"
                                                               Foreground="{StaticResource MutedBrush}"/>
                                                </Border>
                                                <Button Content="粘贴" Style="{StaticResource MiniGhost}"
                                                        Padding="12,6" FontSize="12" Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Click="OnAppIconPasteClick" ToolTip="从剪贴板粘贴图片预览设为软件图标（Ctrl+V）"/>
                                                <Button Content="浏览…" Style="{StaticResource MiniGhost}"
                                                        Padding="12,6" FontSize="12" Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Click="OnAppIconBrowseClick" ToolTip="从文件对话框选择图片预览设为软件图标"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Button x:Name="appIconConfirm" Content="确认应用" Style="{StaticResource MiniAccent}"
                                                        Padding="14,6" FontSize="12" IsEnabled="False"
                                                        Click="OnAppIconConfirmClick"
                                                        ToolTip="把当前预览的图片生成为软件图标并保存（重启后生效）"/>
                                                <Button x:Name="appIconCancel" Content="取消" Style="{StaticResource MiniGhost}"
                                                        Padding="14,6" FontSize="12" Margin="6,0,0,0" IsEnabled="False"
                                                        Click="OnAppIconCancelClick"
                                                        ToolTip="放弃当前预览的图片，不做任何改动"/>
                                                <Button Content="恢复默认" Style="{StaticResource MiniGhost}"
                                                        Padding="14,6" FontSize="12" Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        IsEnabled="{Binding HasCustomAppIcon, Mode=OneWay}"
                                                        Click="OnAppIconResetClick" ToolTip="清除自定义软件图标，恢复内置默认"/>
                                            </StackPanel>
                                            <TextBlock x:Name="appIconStatus" Text=""
                                                       Foreground="#4CC38A" FontSize="11" TextWrapping="Wrap"
                                                       Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="支持 ico/png/jpg/jpeg/bmp/gif。拖入图片、Ctrl+V /「粘贴」或「浏览…」选取后先进预览区，点「确认应用」才保存并重启生效；「取消」则放弃。"
                                       Style="{StaticResource Caption}" Margin="0,8,0,6"/>

                            <Grid x:Name="iconHeaderGrid" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="图标预设" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center">
                                        <Run Text="(" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                        <Run Text="{Binding PresetIcons.Count, Mode=OneWay}" Foreground="#FFB4B9C2" FontSize="12"/>
                                        <Run Text="个 / " Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                        <Run Text="{Binding PresetIcons.GroupCount, Mode=OneWay}" Foreground="#FFB4B9C2" FontSize="12"/>
                                        <Run Text="个分组)" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="添加分组" Style="{StaticResource MiniGhost}"
                                            Padding="10,4" FontSize="11"
                                            Click="OnIconGroupAddClick" ToolTip="新增图标分组"/>
                                    <Button Content="添加图标…" Style="{StaticResource MiniAccent}"
                                            Padding="10,4" FontSize="11" Margin="6,0,0,0"
                                            Click="OnPresetAddClick" ToolTip="从系统对话框选择图标文件加入当前分组"/>
                                    <Button Content="粘贴图标" Style="{StaticResource MiniGhost}"
                                            Padding="10,4" FontSize="11" Margin="6,0,0,0"
                                            Click="OnPresetPasteClick" ToolTip="从剪贴板粘贴图片加入当前分组（Ctrl+V）"/>
                                </StackPanel>
                            </Grid>

                            <!-- 操作提示：图标文件可直接拖入任意分组，无需单独拖入框 -->
                            <TextBlock Text="将 ico/png/jpg 等图标文件直接拖入任意分组即可加入；复制图片后按 Ctrl+V 或点「粘贴图标」也可加入；双击图标项重命名，悬浮可删除。"
                                       Style="{StaticResource Caption}" Margin="2,0,0,6"/>

                            <!-- 行为设置：修改图标是否同步到资源管理器 -->
                            <Border Background="{StaticResource NeuInset}" BorderBrush="{StaticResource NeuBezelPress}"
                                    BorderThickness="1" CornerRadius="{StaticResource NeuRadius6}" Padding="14,10" Margin="0,2,0,6">
                                <CheckBox Content="修改图标同步生效到资源管理器（写入文件夹 desktop.ini）"
                                          IsChecked="{Binding IconsAffectExplorer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource CheckLabel}"
                                          ToolTip="开启后修改/恢复图标会同时改变文件资源管理器中的文件夹图标；关闭则仅本工具界面内显示自定义图标"/>
                            </Border>

                            <!-- 分组列表：拖拽排序（悬浮跟随+实时让位）、折叠/展开、双击文字重命名；独立滚动 -->
                            <Grid>
                                <ScrollViewer x:Name="iconListScroll" MaxHeight="680" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Margin="0,0,0,4">
                                    <ItemsControl x:Name="iconGroupList"
                                                  ItemsSource="{Binding PresetIcons.Groups}"
                                                  ItemTemplate="{StaticResource IconGroupTemplate}"
                                                  AllowDrop="True"
                                                  DragOver="OnIconGroupDragOver"
                                                  Drop="OnIconGroupDrop">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <app:AnimatedStackPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>
                                <!-- 拖拽反馈覆盖层（不参与命中）：分组插入横条 / 图标缝隙竖条 / 跨组目标高亮框 -->
                                <Canvas x:Name="iconDragOverlay" IsHitTestVisible="False">
                                    <Rectangle x:Name="iconInsertBar" Fill="{StaticResource AccentBrush}"
                                               Height="2" RadiusX="1" RadiusY="1" Visibility="Collapsed"/>
                                    <Rectangle x:Name="iconItemBar" Fill="{StaticResource AccentBrush}"
                                               Width="2" RadiusX="1" RadiusY="1" Visibility="Collapsed"/>
                                    <Rectangle x:Name="iconTargetBox" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                                               Fill="#303B82F6" RadiusX="5" RadiusY="5" Visibility="Collapsed"/>
                                </Canvas>
                            </Grid>

                            <TextBlock x:Name="iconErrorText" Text="{Binding PresetIcons.Error}"
                                       Foreground="#E5484D" FontSize="11" TextWrapping="Wrap" Margin="2,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PresetIcons.HasError}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- ========== 页签内容：快捷键 ========== -->
                        <StackPanel x:Name="TabShortcuts" Visibility="Collapsed">
                            <Grid Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="快捷键" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center">
                                        <Run Text="『按下新组合键即可修改；Backspace 清除可禁用』" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                    </TextBlock>
                                </StackPanel>
                                <Button Content="全部恢复默认" Style="{StaticResource MiniGhost}"
                                        HorizontalAlignment="Right" Padding="14,5" FontSize="12"
                                        Command="{Binding Shortcuts.ResetAllCommand}" ToolTip="将所有快捷键恢复为默认键位"/>
                            </Grid>

                            <Border Background="{StaticResource NeuInset}" BorderBrush="{StaticResource NeuBezelPress}"
                                    BorderThickness="1" CornerRadius="{StaticResource NeuRadius6}" Padding="10,6">
                                <Border.Resources>
                                    <DataTemplate x:Key="ShortcutRowTemplate">
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource ItemTitle}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding GestureDisplay}" Style="{StaticResource Caption}"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                        HorizontalAlignment="Right">
                                                <Button Content="修改" Style="{StaticResource MiniGhost}"
                                                        Margin="0,0,6,0" Click="OnShortcutEditClick" ToolTip="按下新组合键修改快捷键"/>
                                                <Button Content="恢复默认" Style="{StaticResource MiniGhost}"
                                                        Click="OnShortcutResetClick" ToolTip="恢复为该动作的默认键位"
                                                        IsEnabled="{Binding CanReset}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </Border.Resources>
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding Shortcuts.Group1Items}"
                                                  ItemTemplate="{StaticResource ShortcutRowTemplate}"/>

                                    <!-- 分隔线：常规 / 项目操作 -->
                                    <Border Height="1" Background="{StaticResource NeuBezelPress}" Margin="0,10" Opacity="0.7"/>
                                    <ItemsControl ItemsSource="{Binding Shortcuts.Group2Items}"
                                                  ItemTemplate="{StaticResource ShortcutRowTemplate}"/>

                                    <!-- 分隔线：项目操作 / 页签切换 -->
                                    <Border Height="1" Background="{StaticResource NeuBezelPress}" Margin="0,10" Opacity="0.7"/>
                                    <ItemsControl ItemsSource="{Binding Shortcuts.Group3Items}"
                                                  ItemTemplate="{StaticResource ShortcutRowTemplate}"/>

                                    <!-- 分隔线：预设快捷键 / 自定义连锁动作 -->
                                    <Border Height="1" Background="{StaticResource NeuBezelPress}" Margin="0,10" Opacity="0.7"/>

                                    <ItemsControl ItemsSource="{Binding Shortcuts.ChainItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource ItemTitle}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding GestureDisplay}" Style="{StaticResource Caption}"
                                                               VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                                HorizontalAlignment="Right">
                                                        <Button Content="修改" Style="{StaticResource MiniGhost}"
                                                                Margin="0,0,6,0" Click="OnChainShortcutEditClick" ToolTip="按下新组合键修改快捷键"/>
                                                        <Button Content="清除" Style="{StaticResource MiniGhost}"
                                                                Click="OnChainShortcutClearClick" ToolTip="清除该动作的快捷键"
                                                                IsEnabled="{Binding HasGesture}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 分隔线：应用级自定义 / 脑图编辑器固定快捷键 -->
                                    <Border Height="1" Background="{StaticResource NeuBezelPress}" Margin="0,10" Opacity="0.7"/>
                                    <TextBlock Text="脑图编辑器快捷键" Style="{StaticResource ItemTitle}" Margin="0,0,0,2"/>
                                    <TextBlock Text="作用于脑图画布（页面焦点在画布上时生效），为固定默认键位，暂不支持在设置中修改；如需增删键位需改 index.html 快捷键模块。"
                                               Style="{StaticResource Caption}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Tab" Style="{StaticResource Caption}" Grid.Row="0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="插入子节点并开始编辑文字" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Enter" Style="{StaticResource Caption}" Grid.Row="1" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="插入同级节点（当前节点之后；根/无选中则插子节点）" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Delete / Backspace" Style="{StaticResource Caption}" Grid.Row="2" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="删除选中节点（根节点除外）" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Ctrl+B" Style="{StaticResource Caption}" Grid.Row="3" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="加粗" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Ctrl+I" Style="{StaticResource Caption}" Grid.Row="4" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="斜体" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Ctrl+D" Style="{StaticResource Caption}" Grid.Row="5" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="删除线" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Ctrl+E" Style="{StaticResource Caption}" Grid.Row="6" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="水平居中对齐" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Ctrl+L" Style="{StaticResource Caption}" Grid.Row="7" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="7" Grid.Column="1" Text="水平左对齐" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Ctrl+R" Style="{StaticResource Caption}" Grid.Row="8" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="8" Grid.Column="1" Text="水平右对齐" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Ctrl+Shift+C" Style="{StaticResource Caption}" Grid.Row="9" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="9" Grid.Column="1" Text="复制节点样式" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Ctrl+Shift+V" Style="{StaticResource Caption}" Grid.Row="10" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="10" Grid.Column="1" Text="粘贴节点样式" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Ctrl+A" Style="{StaticResource Caption}" Grid.Row="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="11" Grid.Column="1" Text="全选全部节点（内核内置）" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                        <TextBlock Text="方向键 ↑ ← ↓ →" Style="{StaticResource Caption}" Grid.Row="12" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="12" Grid.Column="1" Text="按方向在邻近节点间移动选中（内核内置）" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                        <TextBlock Text="/" Style="{StaticResource Caption}" Grid.Row="13" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="13" Grid.Column="1" Text="展开 / 折叠当前节点（内核内置）" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Alt+1~5 / Alt+`" Style="{StaticResource Caption}" Grid.Row="14" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="14" Grid.Column="1" Text="展开到第 N 层 / 全部展开（内核内置）" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ========== 页签内容：Agent 连锁 ========== -->
                        <StackPanel x:Name="TabAgentChain" Visibility="Collapsed">
                            <Grid Margin="0,2,0,6">
                                <TextBlock Text="Agent 连锁" Style="{StaticResource SectionTitle}"/>
                            </Grid>

                            <!-- 默认客户端：卡片选择区 + 已安装客户端自动检测刷新 + 手动添加 -->
                            <Border Background="{StaticResource NeuInset}" BorderBrush="{StaticResource NeuBezelPress}"
                                    BorderThickness="1" CornerRadius="{StaticResource NeuRadius6}" Padding="10,7" Margin="0,0,0,6">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="默认客户端" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="刷新检测" Style="{StaticResource MiniGhost}" Padding="10,4"
                                                    Margin="0,0,6,0" VerticalAlignment="Center"
                                                    Click="OnAcRefreshClientsClick"
                                                    ToolTip="重新扫描本机已安装的桌面 AI 客户端"/>
                                            <Button Content="手动添加…" Style="{StaticResource MiniGhost}" Padding="10,4"
                                                    VerticalAlignment="Center"
                                                    Click="OnAcAddClientClick"
                                                    ToolTip="自动检测不到的客户端（选择其 exe）可在此手动添加"/>
                                        </StackPanel>
                                    </Grid>
                                    <!-- 选择区：WrapPanel 平铺 头像+名称；单击即设为全局默认 -->
                                    <ListBox ItemsSource="{Binding ChainClientCards}"
                                             SelectedItem="{Binding SelectedChainClientCard, Mode=TwoWay}"
                                             Background="Transparent" BorderThickness="0"
                                             MaxHeight="150" Margin="0,6,0,0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="bd" Background="Transparent" CornerRadius="{StaticResource NeuRadius5}"
                                                                    BorderThickness="1" BorderBrush="Transparent"
                                                                    Padding="8,4" Margin="0,0,6,6" Cursor="Hand">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Border Width="20" Height="20" CornerRadius="{StaticResource NeuRadius10}"
                                                                            Background="{StaticResource NeuInset}"
                                                                            BorderBrush="{StaticResource NeuBezelPress}"
                                                                            BorderThickness="1">
                                                                        <TextBlock Text="{Binding Avatar}" FontSize="10" FontWeight="Bold"
                                                                                   Foreground="{StaticResource AccentBrush}"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding DisplayName}" FontSize="11" Margin="6,0,0,0"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{StaticResource MainBrush}"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource NeuSurfaceHi}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource NeuAccentTint}"/>
                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeuBezelPress}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </StackPanel>
                            </Border>

                            <!-- 占位符快速插入按钮排：点击插入到最近聚焦的模板框光标处 -->
                            <Border Background="{StaticResource NeuInset}" BorderBrush="{StaticResource NeuBezelPress}"
                                    BorderThickness="1" CornerRadius="{StaticResource NeuRadius6}" Padding="10,7">
                                <StackPanel>
                                    <TextBlock Text="占位符（点击插入到最近编辑的模板框光标处；发送前自动替换为实际值）" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                                    <WrapPanel>
                                        <Button Content="{}{项目名称}" Style="{StaticResource MiniGhost}" Margin="0,0,6,4"
                                                Click="OnPlaceholderInsertClick" Tag="{}{项目名称}"
                                                ToolTip="对象的显示名（文件夹名）"/>
                                        <Button Content="{}{项目路径}" Style="{StaticResource MiniGhost}" Margin="0,0,6,4"
                                                Click="OnPlaceholderInsertClick" Tag="{}{项目路径}"
                                                ToolTip="对象完整路径"/>
                                        <Button Content="{}{文件夹名}" Style="{StaticResource MiniGhost}" Margin="0,0,6,4"
                                                Click="OnPlaceholderInsertClick" Tag="{}{文件夹名}"
                                                ToolTip="同 {项目名称}"/>
                                        <Button Content="{}{路径}" Style="{StaticResource MiniGhost}" Margin="0,0,6,4"
                                                Click="OnPlaceholderInsertClick" Tag="{}{路径}"
                                                ToolTip="同 {项目路径}"/>
                                        <Button Content="{}{工具路径}" Style="{StaticResource MiniGhost}" Margin="0,0,6,4"
                                                Click="OnPlaceholderInsertClick" Tag="{}{工具路径}"
                                                ToolTip="本工具 exe 完整路径"/>
                                        <Button Content="{}{工具文件名}" Style="{StaticResource MiniGhost}" Margin="0,0,6,4"
                                                Click="OnPlaceholderInsertClick" Tag="{}{工具文件名}"
                                                ToolTip="本工具 exe 文件名"/>
                                        <Button Content="{}{工具根目录}" Style="{StaticResource MiniGhost}"
                                                Click="OnPlaceholderInsertClick" Tag="{}{工具根目录}"
                                                ToolTip="本工具 exe 所在目录"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="每个动作区分「项目 / 项目组」两份模板；留空恢复内置默认，改动失焦即保存。页签可拖拽换序（自定义之间）；右键页签可重命名/删除/移动；＋号新增自定义动作。"
                                       Style="{StaticResource Caption}" Margin="0,8,0,4"/>

                            <!-- 动作页签行：内置锁定在前，自定义可拖拽换序（悬浮跟随+插入条+滑动动画）；＋号新增 -->
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <ListBox x:Name="acTabs" Background="Transparent" BorderThickness="0"
                                             ItemsSource="{Binding ChainActions}"
                                             SelectedItem="{Binding SelectedChainAction, Mode=TwoWay}"
                                             SelectionChanged="OnAcTabSelectionChanged"
                                             ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             ItemContainerStyle="{StaticResource AcTabPill}">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                    </ListBox>
                                    <!-- 拖拽插入条覆盖层 -->
                                    <Canvas x:Name="acDragOverlay" IsHitTestVisible="False">
                                        <Rectangle x:Name="acInsertBar" Width="3" RadiusX="1.5" RadiusY="1.5"
                                                   Fill="{StaticResource AccentBrush}" Opacity="0.9"
                                                   Visibility="Collapsed"/>
                                    </Canvas>
                                </Grid>
                                <Button Grid.Column="1" Content="＋" Style="{StaticResource MiniGhost}" Padding="10,4"
                                        Margin="6,0,0,0" VerticalAlignment="Center" FontSize="13"
                                        Click="OnAcAddClick" ToolTip="添加自定义连锁动作"/>
                            </Grid>

                            <!-- 选中动作详情：项目/项目组 子切换 + 模板框 + 入口勾选 -->
                            <Border Background="{StaticResource NeuInset}" BorderBrush="{StaticResource NeuBezelPress}"
                                    BorderThickness="1" CornerRadius="{StaticResource NeuRadius6}" Padding="14,12" Margin="0,8,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="acScopeProject" Content="项目" Style="{StaticResource AcSegRadio}"
                                                         GroupName="AcScope" IsChecked="True" Checked="OnAcScopeChecked"/>
                                            <RadioButton x:Name="acScopeGroup" Content="项目组" Style="{StaticResource AcSegRadio}"
                                                         GroupName="AcScope" Checked="OnAcScopeChecked"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <CheckBox x:Name="acFlagSidebar" Content="加入侧边栏" Tag="sidebar"
                                                      Checked="OnAcFlagChanged" Unchecked="OnAcFlagChanged"
                                                      Style="{StaticResource CheckLabel}" Margin="0,0,14,0"/>
                                            <CheckBox x:Name="acFlagContext" Content="加入右键菜单" Tag="context"
                                                      Margin="0"
                                                      Checked="OnAcFlagChanged" Unchecked="OnAcFlagChanged"
                                                      Style="{StaticResource CheckLabel}"/>
                                            <ComboBox x:Name="acActionClient" Style="{StaticResource NeuComboBox}"
                                                      Width="148" Height="24" Margin="12,0,0,0" VerticalAlignment="Center"
                                                      ItemsSource="{Binding ChainClientChoices}"
                                                      SelectedValuePath="Value"
                                                      SelectionChanged="OnAcActionClientChanged"
                                                      ToolTip="本动作专属发送客户端；「默认（跟随全局）」使用上方全局选择">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <TextBox x:Name="acTemplateBox" Style="{StaticResource NeuTextBox}"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140"
                                             VerticalContentAlignment="Top"
                                             VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"
                                             GotFocus="OnTemplateBoxGotFocus" LostFocus="OnTemplateBoxLostFocus"/>
                                    <TextBlock x:Name="acTemplateCaption" Text="占位符：{项目名称}/{文件夹名}=显示名；{项目路径}/{路径}=完整路径；{工具路径}/{工具文件名}/{工具根目录}=本工具信息。内置动作模板留空恢复默认。"
                                               Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ========== 页签内容：脑图 ========== -->
                        <StackPanel x:Name="TabMindMap" Visibility="Collapsed">
                            <Grid Margin="0,2,0,6">
                                <TextBlock Text="脑图动画" Style="{StaticResource SectionTitle}"/>
                            </Grid>
                            <Border Background="{StaticResource NeuInset}" BorderBrush="{StaticResource NeuBezelPress}"
                                    BorderThickness="1" CornerRadius="{StaticResource NeuRadius6}" Padding="14,12">
                                <StackPanel>
                                    <CheckBox Content="画布打开/展开收起分支时播放过渡动画"
                                              IsChecked="{Binding MindMapLayoutAnimation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource CheckLabel}" Margin="0,4"
                                              ToolTip="勾选后打开画布及展开/收起分支时播放约 300ms 的节点扩散过渡动画；取消（默认）则直接显示最终布局，无动画。仅影响布局过渡，缩放与视图移动动画不受影响"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="布局过渡动画控制节点展开/收起的平滑扩散效果；关闭后打开画布和展开分支均直接跳变到位，响应更快。"
                                       Style="{StaticResource Caption}" Margin="0,8,0,4" TextWrapping="Wrap"/>

                            <Grid Margin="0,2,0,6">
                                <TextBlock Text="脑图备份" Style="{StaticResource SectionTitle}"/>
                            </Grid>
                            <Border Background="{StaticResource NeuInset}" BorderBrush="{StaticResource NeuBezelPress}"
                                    BorderThickness="1" CornerRadius="{StaticResource NeuRadius6}" Padding="14,12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="自动备份间隔" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                                        <ComboBox Grid.Column="1" Style="{StaticResource NeuComboBox}" HorizontalAlignment="Left"
                                                  Width="150"
                                                  SelectedValuePath="Tag"
                                                  SelectedValue="{Binding MindMapBackupMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="脑图内容发生改动时按此间隔自动备份一次；关闭则仅手动触发">
                                            <ComboBoxItem Content="关闭" Tag="0"/>
                                            <ComboBoxItem Content="每 1 分钟" Tag="1"/>
                                            <ComboBoxItem Content="每 2 分钟" Tag="2"/>
                                            <ComboBoxItem Content="每 5 分钟" Tag="5"/>
                                            <ComboBoxItem Content="每 10 分钟" Tag="10"/>
                                            <ComboBoxItem Content="每 30 分钟" Tag="30"/>
                                        </ComboBox>
                                    </Grid>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="最多保留份数" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                                        <ComboBox Grid.Column="1" Style="{StaticResource NeuComboBox}" HorizontalAlignment="Left"
                                                  Width="150"
                                                  SelectedValuePath="Tag"
                                                  SelectedValue="{Binding MindMapBackupMax, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="同一份脑图最多保留的备份份数，超出自动删除最旧的一份">
                                            <ComboBoxItem Content="1 份" Tag="1"/>
                                            <ComboBoxItem Content="2 份" Tag="2"/>
                                            <ComboBoxItem Content="3 份" Tag="3"/>
                                            <ComboBoxItem Content="5 份" Tag="5"/>
                                            <ComboBoxItem Content="10 份" Tag="10"/>
                                        </ComboBox>
                                    </Grid>

                                    <TextBlock Text="备份目录（只读）" Style="{StaticResource FieldLabel}" Margin="0,12,0,3"/>
                                    <TextBlock Text="{Binding ResolvedMindMapBackupDir}" Style="{StaticResource ItemTitleMono}"
                                               TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="修改" Style="{StaticResource MiniGhost}" Padding="14,5" Margin="0,0,8,0"
                                                Click="OnMindMapBackupDirModifyClick"
                                                ToolTip="选择新的备份目录，并将现有备份文件整体迁移过去"/>
                                        <Button Content="打开备份文件夹" Style="{StaticResource MiniGhost}" Padding="14,5"
                                                Click="OnOpenMindMapBackupDirClick"
                                                ToolTip="在资源管理器中打开脑图备份文件夹"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="脑图内容发生改动时按设定间隔自动备份，保留最近 N 份；备份为完整状态快照（内容/主题/布局），改动即时保存。"
                                       Style="{StaticResource Caption}" Margin="0,8,0,4" TextWrapping="Wrap"/>
                        </StackPanel>

                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
