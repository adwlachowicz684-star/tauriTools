# 依赖与构建产物
node_modules/
dist/
dist-ssr/
*.local

# iframe 插件独立构建产物（scripts/build-plugins.mjs 生成，npm run build 内含）
# 与 dist/ 同类：改插件前端只重跑插件构建，主程序零重编；正式版经
# tauri.conf.json 的 bundle.resources 收进安装包，不入库
runtime-plugins/

# Vite 加载 TS 配置时生成的临时文件；构建被中断（Ctrl-C / 端口冲突）会残留，
# 每次都污染 git status，还可能被误提交
vite.config.ts.timestamp-*.mjs

# 系统 / 编辑器
.DS_Store
Thumbs.db

# 运行期状态与日志
.audit-state.json
*.log
npm-debug.log*

# 校验脚本产物
.smoke-react.cjs
.drag-payload-test*.cjs
# 全量体检的明细落盘目录（sweep-tests.mjs 写在项目内 ROOT/.tool_output）
# 不忽略的话跑一次就多一个未跟踪目录，容易被当成新改动一起提交
.tool_output/

# 本地临时测试脚手架（不入库）
.rt/
