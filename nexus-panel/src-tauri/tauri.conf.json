{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexus Panel",
  "version": "0.1.0",
  "identifier": "com.nexus.panel",
  "build": {
    "frontendDist": "../"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nexus Panel",
        "width": 1220,
        "height": 780,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "decorations": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
