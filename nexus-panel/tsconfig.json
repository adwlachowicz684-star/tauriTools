{
  "compilerOptions": {
    "target": "ES2021",
    "useDefineForClassFields": true,
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": false,
    "types": ["vite/client"]
  },
  "include": ["src", "js", "plugins/**/*.ts", "plugins/**/*.tsx"],
  "exclude": [
    "plugins/**/tests/**",
    "plugins/**/scripts/**"
  ],
  "_comment": "tests/ 与 scripts/ 跑在 Node 测试运行器下（用 node:test，无 DOM），与浏览器端的 lib 配置不同，故不纳入本项目的类型检查",
  "references": [{ "path": "./tsconfig.node.json" }]
}
